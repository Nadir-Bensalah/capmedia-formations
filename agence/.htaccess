# ============================================================================
# CAPMEDIA DIGITAL · capmedia.app (racine)
# Ne touche pas au chemin /academy : le site Academy vit dans son propre
# sous-dossier avec sa propre configuration.
# ============================================================================

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.capmedia.app -> https://capmedia.app (apex), en une seule redirection
  RewriteCond %{HTTP_HOST} ^www\.capmedia\.app$ [NC]
  RewriteRule ^(.*)$ https://capmedia.app/$1 [R=301,L]

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://capmedia.app/$1 [R=301,L]
</IfModule>

# --- index vers la racine ---------------------------------------------------
# /index et /dossier/index n'ont pas lieu d'être : une page, une seule URL.
# Cette règle passe AVANT la réécriture sans extension, sinon elle ne voit rien.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/academy/
  RewriteRule ^(.*)index$ https://capmedia.app/$1 [R=301,L,NE]
</IfModule>

# --- URL sans extension ----------------------------------------------------
# /fondateur sert fondateur.html. L'ancienne adresse en .html redirige une
# fois pour toutes vers la propre : une seule URL par page, pour les visiteurs
# comme pour Google. La chaîne de requête (?session_id=…) est conservée.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} !^/academy/
  RewriteCond %{THE_REQUEST} \s/+(.*)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  RewriteCond %{REQUEST_URI} !^/academy/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>


# --- Pages HTML toujours revalidées ------------------------------------------
# Les scripts et les feuilles portent une estampille de version (?v=…), pas
# les pages. Sans cet en-tête, un navigateur ou une application de bureau
# garde une page des heures sur la foi de sa date de modification, et montre
# l'ancienne porte après une mise en ligne. « no-cache » = garder, mais
# redemander au serveur à chaque fois (réponse 304 si rien n'a changé).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Notifications push de l'espace de suivi ---------------------------------
# Le manifeste (installer le Hub ou le Cockpit sur l'écran d'accueil d'un
# iPhone, seule façon d'y recevoir les push) avec son type, et le service
# des notifications (suivi/sw.js) toujours revalidé : une correction du
# service doit atteindre les appareils abonnés sans attendre sept jours.
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/suivi/sw\.js$#">
    Header set Cache-Control "no-cache, must-revalidate"
  </If>
</IfModule>

# --- En-têtes de sécurité de l'espace de suivi (/suivi seulement) -----------
# Le Hub, le Cockpit, l'espace Test et la porte de connexion. Une seule XSS
# sur cette origine lirait tout ce que la page lit : la politique ne laisse
# exécuter que les fichiers du site et le SDK Firebase de la version utilisée,
# et ne laisse parler la page qu'aux services Firebase du projet. Détail et
# raisons : docs/suivi.md, « En-têtes de sécurité ». Les pages portent la même
# politique en <meta> (avec 127.0.0.1 en plus pour le banc local) : le
# navigateur applique les deux, la plus stricte gagne. frame-ancestors et
# upgrade-insecure-requests n'existent qu'en en-tête.
# Le reste du site (pages, /academy) n'est pas concerné.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/suivi(/|$)#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.gstatic.com/firebasejs/10.13.2/; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://storage.googleapis.com https://www.google.com/images/cleardot.gif; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebasestorage.googleapis.com https://europe-west1-capmedia-1f90d.cloudfunctions.net; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), publickey-credentials-get=(self), publickey-credentials-create=(self)"
    # Tout capmedia.app est servi en https (redirection en tête de fichier) :
    # le navigateur s'en souvient un an. Sans sous-domaines, sans preload.
    Header always set Strict-Transport-Security "max-age=31536000"
  </If>
</IfModule>
