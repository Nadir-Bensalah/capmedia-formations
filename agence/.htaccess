# ============================================================================
# CAPMEDIA DIGITAL · capmedia.app (racine)
# Ne touche pas au chemin /academy : le site Academy vit dans son propre
# sous-dossier avec sa propre configuration.
# ============================================================================

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.capmedia.app -> https://capmedia.app (apex), en une seule redirection
  RewriteCond %{HTTP_HOST} ^www\.capmedia\.app$ [NC]
  RewriteRule ^(.*)$ https://capmedia.app/$1 [R=301,L]

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://capmedia.app/$1 [R=301,L]
</IfModule>

# --- URL sans extension ----------------------------------------------------
# /fondateur sert fondateur.html. L'ancienne adresse en .html redirige une
# fois pour toutes vers la propre : une seule URL par page, pour les visiteurs
# comme pour Google. La chaîne de requête (?session_id=…) est conservée.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} !^/academy/
  RewriteCond %{THE_REQUEST} \s/+(.*)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  RewriteCond %{REQUEST_URI} !^/academy/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# --- index vers la racine ---------------------------------------------------
# /index et /dossier/index n'ont pas de raison d'exister : une page, une URL.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} !^/academy/
  RewriteRule ^(.*)index$ https://capmedia.app/$1 [R=301,L,NE]
</IfModule>
