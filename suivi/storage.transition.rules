rules_version = '2';

/*
  CAPMEDIA CLIENT HUB · Règles Storage DE TRANSITION (Release Gate 1)
  Projet Firebase : capmedia-1f90d.

  Déployées avant la migration de la Gate 1, remplacées ensuite par
  storage.rules. Seule différence avec storage.rules : l'ancien rangement
  projets/{p}/documents/** garde ses droits d'avant (voir plus bas).
  storage.test.mjs vérifie qu'il n'y en a pas d'autre, et la Gate 2 les a
  tenues alignées sur le reste de storage.rules.

  Une seule source d'autorité : Firestore, relu à chaque requête (Gate 2).
  Le jeton ne sert qu'à choisir la branche à vérifier (équipe, client,
  testeur) ; il ne suffit jamais à ouvrir. Une session ouverte avant une
  désactivation ou un retrait d'accès est donc refusée tout de suite, sans
  attendre l'heure d'expiration du jeton :
  - l'équipe : la fiche equipe/{uid} doit être ACTIVE, et un agent ne voit
    que les projets de sa fiche ;
  - le client : il doit figurer dans projets/{p}.membres (calculé par le
    serveur), et la finance est réservée au responsable (projets/{p}.roles) ;
  - le testeur : une fiche active et sa place dans la campagne.
  Une règle Storage ne peut lire que DEUX documents Firestore : chaque
  branche est écrite pour ne jamais en lire plus.

  La fiche d'un fichier reste la seule vérité sur sa visibilité : changer
  la visibilité d'un fichier ou passer un devis en brouillon change aussitôt
  qui peut lire le PDF, sans déplacer d'objet.

  Trois principes :
  - « read » est découpé : « get » (télécharger un fichier connu) peut être
    ouvert au client, « list » (parcourir un dossier) ne l'est jamais. Un
    client ne découvre donc pas un fichier qu'on ne lui montre pas.
  - un client ou un testeur CRÉE, il ne réécrit jamais : « update » est
    réservé à l'équipe. Personne n'écrase la pièce d'un autre. En
    production, écrire sur un objet qui existe est un « update », pas un
    « create ». (L'émulateur confond les deux : storage.test.mjs le détecte
    et classe ces essais « non vérifiables au banc ».)
  - ce qui n'est pas prévu ici est refusé (dernière règle).

  Organisation :
    projets/{p}/fichiers/{fichierId}/...   fichiers du projet, lisibles selon la fiche fichiers/{fichierId}
    projets/{p}/pieces/{documentId}/...    PDF d'un devis ou d'une facture, jamais en brouillon
    projets/{p}/tickets/{t}/...            pièces des demandes (une pièce de note interne est marquée « interne »)
    projets/{p}/messages/...               pièces de la conversation du projet
    projets/{p}/validations/...            pièces d'une demande de validation
    projets/{p}/validations/{v}/reponse/.. pièces de la réponse du client à cette validation
    projets/{p}/taches/{t}/reponse/...     pièces de la réponse du client sur une tâche
    campagnes/{p}/{c}/{uid}/...            preuves d'un testeur de la campagne
    projets/{p}/campagnes/{c}/visuels/...  écrans de l'application en campagne
    projets/{p}/campagnes/{c}/logo/{f}     logo de l'application en campagne (image, 2 Mo)
    preprojets/{uid}/...                   pièces d'une demande de nouveau projet
    conversationsTesteurs/{uid}/...        pièces de la conversation d'un testeur avec l'équipe
    projets/{p}/documents/...              ANCIEN rangement, en attente de migration
*/

service firebase.storage {
  match /b/{bucket}/o {

    function fiche(chemin) {
      return firestore.get(chemin).data;
    }

    // La branche : un jeton d'équipe se vérifie contre la fiche d'équipe,
    // tout autre jeton contre les membres du projet. Jamais les deux, pour
    // tenir dans les deux lectures permises.
    function jetonEquipe() {
      return request.auth != null && request.auth.token.get('equipe', false) == true;
    }

    function ficheEquipe() {
      return fiche(/databases/(default)/documents/equipe/$(request.auth.uid));
    }

    // Membre ACTIF de l'équipe (une lecture).
    function estEquipe() {
      return jetonEquipe() && ficheEquipe().get('actif', false) == true;
    }

    function estAdmin() {
      return estEquipe() && ficheEquipe().get('role', '') == 'admin';
    }

    // Membre actif de l'équipe, autorisé sur ce projet (une lecture).
    function equipeSurProjet(projetId) {
      return estEquipe()
          && (ficheEquipe().get('role', '') == 'admin'
              || projetId in ficheEquipe().get('projets', []));
    }

    // La finance du projet, côté équipe (même lecture que ci-dessus) :
    // un administrateur, ou un agent du projet qui a « finance.lecture »
    // ou « finance.gerer ». Être affecté au projet ne suffit pas.
    function financeEquipe(projetId) {
      return equipeSurProjet(projetId)
          && (ficheEquipe().get('role', '') == 'admin'
              || ficheEquipe().get('permissions', []).hasAny(['finance.lecture', 'finance.gerer']));
    }

    function financeGerer(projetId) {
      return equipeSurProjet(projetId)
          && (ficheEquipe().get('role', '') == 'admin'
              || ficheEquipe().get('permissions', []).hasAny(['finance.gerer']));
    }

    function ficheProjet(projetId) {
      return fiche(/databases/(default)/documents/projets/$(projetId));
    }

    // Client membre effectif du projet (une lecture).
    function surSonProjet(projetId) {
      return request.auth != null && !jetonEquipe()
          && request.auth.uid in ficheProjet(projetId).get('membres', []);
    }

    // Responsable du projet : la finance lui est réservée (même lecture).
    function responsableDuProjet(projetId) {
      return surSonProjet(projetId)
          && ficheProjet(projetId).get('roles', {}).get(request.auth.uid, '') == 'responsable';
    }

    function fichierAccepte() {
      return (request.resource.size < 10 * 1024 * 1024
              && (request.resource.contentType.matches('image/.*')
                  || request.resource.contentType == 'application/pdf'
                  || request.resource.contentType == 'text/plain'
                  || request.resource.contentType == 'application/zip'
                  || request.resource.contentType.matches('application/(msword|vnd\\.openxmlformats-officedocument\\..*)')))
          || (request.resource.size < 100 * 1024 * 1024
              && request.resource.contentType.matches('video/(mp4|quicktime|webm)'));
    }

    // Une pièce marquée « interne » (métadonnée posée par l'équipe) n'est
    // jamais servie au client. Une pièce sans marque est publique pour les
    // membres du projet.
    function pieceInterne() {
      return resource.metadata != null && resource.metadata.get('visibilite', '') == 'interne';
    }

    // Les fichiers d'un projet. Le client ne télécharge que ce que la
    // fiche Firestore lui montre : visibilité « client », non archivé, et
    // rangé sous CE projet. Il dépose ses propres fichiers, sans jamais
    // remplacer un objet existant.
    match /projets/{projetId}/fichiers/{fichierId}/{nom} {
      allow get: if jetonEquipe() ? equipeSurProjet(projetId)
        : (surSonProjet(projetId)
            && fiche(/databases/(default)/documents/fichiers/$(fichierId)).projet == projetId
            && fiche(/databases/(default)/documents/fichiers/$(fichierId)).visibilite == 'client'
            && fiche(/databases/(default)/documents/fichiers/$(fichierId)).get('archive', false) != true);
      allow list:   if equipeSurProjet(projetId);
      allow create: if (jetonEquipe() ? equipeSurProjet(projetId) : surSonProjet(projetId)) && fichierAccepte();
      allow update: if equipeSurProjet(projetId);
      // Retirer : l'équipe, ou le client qui a déposé ce fichier lui-même
      // (la fiche le dit). Deux lectures : le projet, la fiche, une fois
      // chacune.
      function auteurDuFichier(projetId, fichierId) {
        let f = fiche(/databases/(default)/documents/fichiers/$(fichierId));
        return surSonProjet(projetId)
          && f.projet == projetId
          && f.visibilite == 'client'
          && f.get('par', {}).get('uid', '') == request.auth.uid;
      }
      allow delete: if jetonEquipe() ? equipeSurProjet(projetId) : auteurDuFichier(projetId, fichierId);
    }

    // Le PDF d'une pièce comptable. Le chemin porte l'identifiant de la
    // pièce : un brouillon ou une pièce archivée ne se télécharge pas, et
    // seul un responsable du projet le télécharge.
    match /projets/{projetId}/pieces/{documentId}/{nom} {
      // Deux lectures Firestore, et pas un appel de plus : le projet, la
      // pièce, chacun lu UNE fois (« let »). La version d'avant relisait le
      // projet deux fois et la pièce trois fois ; le banc laissait passer,
      // la production refusait la lecture au client (403, 27/09/2026).
      function responsableUneLecture(projetId) {
        let p = ficheProjet(projetId);
        return request.auth != null && !jetonEquipe()
          && request.auth.uid in p.get('membres', [])
          && p.get('roles', {}).get(request.auth.uid, '') == 'responsable';
      }
      function pieceLisible(projetId, documentId) {
        let d = fiche(/databases/(default)/documents/documents/$(documentId));
        return d.projet == projetId && d.statut != 'brouillon' && d.get('archive', false) != true;
      }
      function financeUneLecture(projetId) {
        let f = ficheEquipe();
        return jetonEquipe() && f.get('actif', false) == true
          && (f.get('role', '') == 'admin'
              || (f.get('role', '') == 'agent' && projetId in f.get('projets', [])
                  && f.get('permissions', []).hasAny(['finance.lecture', 'finance.gerer'])));
      }
      allow get: if jetonEquipe() ? financeUneLecture(projetId)
        : (responsableUneLecture(projetId) && pieceLisible(projetId, documentId));
      allow list:   if financeEquipe(projetId);
      allow create, update: if financeGerer(projetId) && fichierAccepte();
      allow delete: if financeGerer(projetId);
    }

    // Les pièces jointes des demandes : l'équipe et le client du projet,
    // sauf une pièce de note interne. Le client dépose, sans réécrire.
    match /projets/{projetId}/tickets/{ticketId}/{fichier=**} {
      allow get:    if jetonEquipe() ? equipeSurProjet(projetId) : (surSonProjet(projetId) && !pieceInterne());
      allow list:   if equipeSurProjet(projetId);
      allow create: if (jetonEquipe() ? equipeSurProjet(projetId) : surSonProjet(projetId)) && fichierAccepte();
      allow update, delete: if equipeSurProjet(projetId);
    }

    // La conversation du projet : tout y est public entre l'équipe et le client.
    match /projets/{projetId}/messages/{fichier=**} {
      allow get:    if jetonEquipe() ? equipeSurProjet(projetId) : surSonProjet(projetId);
      allow list:   if equipeSurProjet(projetId);
      allow create: if (jetonEquipe() ? equipeSurProjet(projetId) : surSonProjet(projetId)) && fichierAccepte();
      allow update, delete: if equipeSurProjet(projetId);
    }

    // Les pièces d'une évolution de maintenance : le client joint une
    // capture ou un croquis à sa proposition, l'équipe et lui les lisent.
    // Le dossier porte l'identifiant de l'évolution, tiré avant l'envoi.
    match /projets/{projetId}/maintenance/{evolutionId}/{fichier=**} {
      allow get:    if jetonEquipe() ? equipeSurProjet(projetId) : surSonProjet(projetId);
      allow list:   if equipeSurProjet(projetId);
      allow create: if (jetonEquipe() ? equipeSurProjet(projetId) : surSonProjet(projetId)) && fichierAccepte();
      allow update, delete: if equipeSurProjet(projetId);
    }

    // La réponse du client à une validation : ses remarques peuvent porter
    // une capture, un document annoté. Il dépose sous « reponse », sans
    // jamais réécrire ; l'équipe et lui les lisent.
    match /projets/{projetId}/validations/{validationId}/reponse/{nom} {
      allow get:    if jetonEquipe() ? equipeSurProjet(projetId) : surSonProjet(projetId);
      allow list:   if equipeSurProjet(projetId);
      allow create: if (jetonEquipe() ? equipeSurProjet(projetId) : surSonProjet(projetId)) && fichierAccepte();
      allow update, delete: if equipeSurProjet(projetId);
    }

    // La réponse du client sur une tâche qui l'attend : même principe, sous
    // « reponse » de la tâche.
    match /projets/{projetId}/taches/{tacheId}/reponse/{nom} {
      allow get:    if jetonEquipe() ? equipeSurProjet(projetId) : surSonProjet(projetId);
      allow list:   if equipeSurProjet(projetId);
      allow create: if (jetonEquipe() ? equipeSurProjet(projetId) : surSonProjet(projetId)) && fichierAccepte();
      allow update, delete: if equipeSurProjet(projetId);
    }

    // Les pièces d'une demande de validation : déposées par l'équipe, lues par le client.
    match /projets/{projetId}/validations/{fichier=**} {
      allow get:    if jetonEquipe() ? equipeSurProjet(projetId) : surSonProjet(projetId);
      allow list:   if equipeSurProjet(projetId);
      allow create, update: if equipeSurProjet(projetId) && fichierAccepte();
      allow delete: if equipeSurProjet(projetId);
    }

    // TRANSITION : l'ANCIEN rangement garde, le temps de la migration, les
    // droits exacts qu'il avait avant la Gate 1 (lecture et dépôt), pour
    // qu'aucun fichier ne devienne illisible entre le moment où la fiche
    // est repointée et la bascule du front. Aucune exposition nouvelle :
    // c'est l'état de production d'avant, sur ce seul dossier.
    match /projets/{projetId}/documents/client/{fichier=**} {
      allow get, list: if estEquipe() || surSonProjet(projetId);
      allow create, update: if (estEquipe() || surSonProjet(projetId)) && fichierAccepte();
      allow delete: if estEquipe();
    }
    match /projets/{projetId}/documents/{dossier}/{fichier=**} {
      allow get, list: if estEquipe() || surSonProjet(projetId);
      allow create, update: if estEquipe() && fichierAccepte();
      allow delete: if estEquipe();
    }

    // Les preuves d'un testeur : une capture, une vidéo courte. Il écrit
    // dans SON dossier, et seulement pour une campagne EN COURS où il
    // figure réellement, tant qu'il n'a pas dit « j'ai terminé » et que
    // l'équipe n'a pas clos son accès (« fins »). L'équipe et le client du
    // projet les lisent.
    match /campagnes/{projetId}/{campagneId}/{uid}/{fichier=**} {
      // Une preuve est une capture ou une vidéo, rien d'autre : ni archive,
      // ni document Office, ni SVG (qui porte du script), que l'équipe et
      // le client ouvriraient ensuite. 10 Mo une image, 50 Mo une vidéo.
      function preuveAcceptee() {
        return (request.resource.size < 10 * 1024 * 1024
                && request.resource.contentType.matches('image/(png|jpeg|webp|heic|heif)'))
            || (request.resource.size < 50 * 1024 * 1024
                && request.resource.contentType.matches('video/(mp4|quicktime|webm)'));
      }
      function campagne() {
        return fiche(/databases/(default)/documents/projets/$(projetId)/campagnes/$(campagneId));
      }
      allow get:  if jetonEquipe() ? equipeSurProjet(projetId) : surSonProjet(projetId);
      allow list: if equipeSurProjet(projetId);
      // Deux lectures : la fiche du testeur (encore active) et la campagne.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.get('testeur', false) == true
        && fiche(/databases/(default)/documents/testeurs/$(uid)).get('actif', true) != false
        && campagne().statut == 'en-cours'
        && uid in campagne().testeurs
        && !(uid in campagne().get('termines', {}))
        && (!(uid in campagne().get('fins', {})) || campagne().get('fins', {})[uid] > request.time)
        && preuveAcceptee();
      allow update, delete: if equipeSurProjet(projetId);
    }

    // Les écrans d'une application en campagne : des captures déposées par
    // l'équipe, que le testeur découvre dans ses premiers pas et que le
    // client relit. Le testeur ne les lit que s'il figure à la campagne :
    // une capture montre un écran qui n'est pas encore public.
    match /projets/{projetId}/campagnes/{campagneId}/visuels/{fichier=**} {
      // Le testeur d'abord (une lecture, la campagne), le client ensuite
      // (une lecture, le projet) : jamais les deux pour la même personne.
      // Deux lectures : la fiche du testeur, relue pour ne pas laisser au
      // retiré l'heure de vie de son jeton, et la campagne, où son accès
      // ne doit pas être clos.
      function testeurDeLaCampagne() {
        return request.auth != null
          && request.auth.token.get('testeur', false) == true
          && fiche(/databases/(default)/documents/testeurs/$(request.auth.uid)).get('actif', true) != false
          && request.auth.uid in fiche(/databases/(default)/documents/projets/$(projetId)/campagnes/$(campagneId)).get('testeurs', [])
          && (!(request.auth.uid in fiche(/databases/(default)/documents/projets/$(projetId)/campagnes/$(campagneId)).get('fins', {}))
              || fiche(/databases/(default)/documents/projets/$(projetId)/campagnes/$(campagneId)).get('fins', {})[request.auth.uid] > request.time);
      }
      allow get: if jetonEquipe() ? equipeSurProjet(projetId)
        : (request.auth != null && request.auth.token.get('testeur', false) == true
           ? testeurDeLaCampagne()
           : surSonProjet(projetId));
      allow list: if equipeSurProjet(projetId);
      allow create, update: if equipeSurProjet(projetId) && fichierAccepte();
      allow delete: if equipeSurProjet(projetId);
    }

    // Le logo de l'application en campagne (08/10/2026) : la même lecture
    // que les écrans (le testeur de la campagne tant que son accès court,
    // le client du projet, l'équipe), et une écriture plus étroite : une
    // image PNG, JPEG ou WebP de 2 Mo au plus. Jamais de SVG, qui porte du
    // script. Un dossier à part, sinon la règle des écrans, plus large,
    // l'emporterait.
    match /projets/{projetId}/campagnes/{campagneId}/logo/{fichier} {
      function testeurDeLaCampagne() {
        return request.auth != null
          && request.auth.token.get('testeur', false) == true
          && fiche(/databases/(default)/documents/testeurs/$(request.auth.uid)).get('actif', true) != false
          && request.auth.uid in fiche(/databases/(default)/documents/projets/$(projetId)/campagnes/$(campagneId)).get('testeurs', [])
          && (!(request.auth.uid in fiche(/databases/(default)/documents/projets/$(projetId)/campagnes/$(campagneId)).get('fins', {}))
              || fiche(/databases/(default)/documents/projets/$(projetId)/campagnes/$(campagneId)).get('fins', {})[request.auth.uid] > request.time);
      }
      allow get: if jetonEquipe() ? equipeSurProjet(projetId)
        : (request.auth != null && request.auth.token.get('testeur', false) == true
           ? testeurDeLaCampagne()
           : surSonProjet(projetId));
      allow list: if equipeSurProjet(projetId);
      function logoAccepte() {
        return request.resource.size < 2 * 1024 * 1024
          && request.resource.contentType.matches('image/(png|jpeg|webp)');
      }
      allow create, update: if equipeSurProjet(projetId) && logoAccepte();
      allow delete: if equipeSurProjet(projetId);
    }

    // Les pièces de la conversation d'un testeur avec l'équipe : le testeur
    // dans SON dossier (une lecture : sa fiche, encore active), l'équipe
    // active (une lecture : sa fiche). Chaque pièce dit qui l'a posée
    // (métadonnée « par ») : le serveur n'efface, à la suppression d'un
    // message, que celles de son auteur. Personne ne réécrit une pièce.
    match /conversationsTesteurs/{testeurId}/{nom} {
      function testeurDeCetteConversation() {
        return request.auth != null && !jetonEquipe()
          && request.auth.uid == testeurId
          && request.auth.token.get('testeur', false) == true
          && fiche(/databases/(default)/documents/testeurs/$(testeurId)).get('actif', true) != false;
      }
      allow get:    if jetonEquipe() ? estEquipe() : testeurDeCetteConversation();
      allow list:   if estEquipe();
      allow create: if (jetonEquipe() ? estEquipe() : testeurDeCetteConversation())
        && request.resource.metadata != null
        && request.resource.metadata.get('par', '') == request.auth.uid
        && fichierAccepte();
      allow update, delete: if estEquipe();
    }

    // Une demande de nouveau projet : le demandeur dépose dans son dossier,
    // l'équipe y dépose aussi ses réponses, pour qu'il puisse les lire.
    match /preprojets/{uid}/{fichier=**} {
      allow get:    if jetonEquipe() ? estAdmin() : (request.auth != null && request.auth.uid == uid);
      allow list:   if estAdmin();
      allow create: if (jetonEquipe() ? estAdmin() : (request.auth != null && request.auth.uid == uid)) && fichierAccepte();
      allow update, delete: if estAdmin();
    }

    // Parcourir un dossier d'un projet (« list ») : l'équipe de ce projet,
    // sauf les pièces comptables, à la finance seule. La racine d'un projet
    // ne se parcourt que par un administrateur (règle suivante) : l'écran
    // ne parcourt jamais, il lit les fiches.
    match /projets/{projetId}/{dossier}/{tout=**} {
      allow list: if dossier == 'pieces' ? financeEquipe(projetId) : equipeSurProjet(projetId);
    }

    // Le reste est fermé. Un administrateur peut parcourir n'importe quel
    // dossier (« list »), sans rien lire ni écrire de plus que ce qui précède.
    match /{tout=**} {
      allow list: if estAdmin();
      allow get, write: if false;
    }
  }
}
