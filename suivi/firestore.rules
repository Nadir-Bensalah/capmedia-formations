rules_version = '2';

/*
  CAPMEDIA CLIENT HUB · Règles Firestore

  Projet Firebase : capmedia-1f90d, distinct de capmedia-academy qui porte
  les formations. Contrat de données : docs/suivi.md

  Trois publics, une seule porte (Gate 2) :

  - l'ÉQUIPE : une fiche equipe/{uid} ACTIVE, relue à chaque requête. Un
    membre désactivé perd tout à l'instant, sans attendre l'expiration de
    son jeton. « admin » voit tout ; « agent » ne voit que les projets de
    sa fiche (equipe.projets).
  - le CLIENT : membre effectif d'un projet (projets.membres, calculé par
    le serveur, vide tant que le projet est fermé), avec un rôle
    (projets.roles) : « responsable » ou « collaborateur ». La finance et
    les engagements (devis, validations réservées) sont au responsable.
    L'organisation ne donne aucun accès.
  - le TESTEUR : la revendication « testeur », une fiche active, ses
    campagnes.

  Toute écriture qui engage (numéro, statut d'une facture, journal d'audit,
  activité, notifications, membres, rôles, interlocuteurs) est refusée au
  navigateur et passe par l'Admin SDK ou par la fonction suiviAdmin.

  La visibilité « interne » est appliquée ici, pas seulement à l'écran :
  un client ne peut lire une tâche, un fichier, une note ou un lien interne
  ni par la liste, ni par l'adresse directe.

  Déployer :
    firebase deploy --config firebase.suivi.json --only firestore:rules --project capmedia-1f90d
*/

service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // Fonctions communes
    // ================================================================

    function connecte() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true;
    }

    function monEmail() {
      return request.auth.token.email.lower();
    }

    function moi() {
      return request.auth.uid;
    }

    // La fiche d'équipe de la personne connectée. Écrite par l'Admin SDK
    // seul, jamais depuis le navigateur.
    function ficheEquipe() {
      return get(/databases/$(database)/documents/equipe/$(moi())).data;
    }

    // Membre ACTIF de l'équipe. La fiche est relue à chaque requête : une
    // désactivation ferme l'accès tout de suite, même à une session ouverte.
    function estEquipe() {
      return connecte()
          && exists(/databases/$(database)/documents/equipe/$(moi()))
          && ficheEquipe().get('actif', false) == true;
    }

    function estAdmin() {
      return estEquipe() && ficheEquipe().get('role', '') == 'admin';
    }

    // Un administrateur travaille sur tous les projets ; un agent sur ceux
    // de sa fiche, et sur aucun autre.
    function equipeSurProjet(projetId) {
      return estEquipe()
          && (ficheEquipe().get('role', '') == 'admin'
              || (ficheEquipe().get('role', '') == 'agent'
                  && projetId in ficheEquipe().get('projets', [])));
    }

    function ficheProjet(projetId) {
      return get(/databases/$(database)/documents/projets/$(projetId)).data;
    }

    // Client autorisé sur ce projet : membre effectif, calculé par le
    // serveur depuis les interlocuteurs actifs d'un projet OUVERT.
    // La finance d'un projet, côté équipe : un administrateur, ou un agent
    // du projet à qui « finance.lecture » ou « finance.gerer » a été
    // donnée. Être affecté au projet ne suffit pas (acces.financeEquipe).
    function financeEquipe(projetId) {
      return equipeSurProjet(projetId)
          && (ficheEquipe().get('role', '') == 'admin'
              || ficheEquipe().get('permissions', []).hasAny(['finance.lecture', 'finance.gerer']));
    }

    function financeGerer(projetId) {
      return equipeSurProjet(projetId)
          && (ficheEquipe().get('role', '') == 'admin'
              || ficheEquipe().get('permissions', []).hasAny(['finance.gerer']));
    }

    function membreDuProjet(projetId) {
      return connecte() && moi() in ficheProjet(projetId).get('membres', []);
    }

    // Le responsable engage le client : devis, validations réservées,
    // pièces comptables. Le collaborateur participe, sans engager.
    function responsableDuProjet(projetId) {
      return membreDuProjet(projetId)
          && ficheProjet(projetId).get('roles', {}).get(moi(), '') == 'responsable';
    }

    function accesProjet(projetId) {
      return equipeSurProjet(projetId) || membreDuProjet(projetId);
    }

    // Ce qu'un client lit d'une ligne d'activité : ce qui est public pour le
    // projet, et ce qui est réservé au responsable s'il l'est.
    function activiteVisible(projetId) {
      return resource.data.visibilite == 'client'
          || (resource.data.visibilite == 'responsable' && responsableDuProjet(projetId));
    }

    // Un client ne lit que ce qui lui est destiné.
    function visiblePourMoi() {
      return estEquipe() || resource.data.visibilite == 'client';
    }

    function texteBorne(valeur, max) {
      return valeur is string && valeur.size() <= max;
    }

    function texteRequis(valeur, max) {
      return valeur is string && valeur.size() > 0 && valeur.size() <= max;
    }

    // La demande d'un forfait de maintenance, écrite par le client : qui,
    // quoi, à quel rythme, quand. Rien d'autre ne passe par lui.
    function demandeDeForfait(d) {
      return d.keys().hasOnly(['par', 'message', 'rythme', 'le'])
          && d.par.uid == moi()
          && texteBorne(d.message, 4000)
          && texteBorne(d.rythme, 60);
    }

    function auteurCoherent(champ) {
      return champ.uid == moi()
          && champ.cote == (estEquipe() ? 'equipe' : 'client');
    }

    // ================================================================
    // L'équipe, les profils, les organisations
    // ================================================================

    match /equipe/{uid} {
      // La fiche d'équipe (nom, adresse, rôle) ne se lit que par l'équipe.
      // Chacun peut lire la SIENNE : c'est ainsi que la session sait si la
      // personne connectée est de l'équipe. Un client, un testeur ou un
      // inconnu ne liste plus l'équipe ; pour mettre un nom sur le
      // responsable de son projet, il lit l'annuaire, qui ne porte que le nom.
      allow get:   if connecte() && (moi() == uid || estEquipe());
      allow list:  if estEquipe();
      allow write: if false;
    }

    // L'annuaire : le seul nom d'un membre de l'équipe, recopié par le
    // serveur depuis sa fiche. Ni adresse, ni rôle.
    match /annuaire/{uid} {
      allow read:  if connecte();
      allow write: if false;
    }

    // Le profil d'une personne : le sien, et rien d'autre. Les champs sont
    // bornés pour qu'un profil ne devienne pas un fourre-tout.
    match /profils/{uid} {
      // Le sien ; l'administrateur aussi. Un agent ne lit pas le profil des
      // clients (le serveur lit les préférences d'envoi par l'Admin SDK).
      allow read: if connecte() && (moi() == uid || estAdmin());
      allow write: if connecte() && moi() == uid
        && request.resource.data.keys().hasOnly([
             'nom', 'telephone', 'entreprise', 'langue', 'fuseau', 'notifications',
             'lus', 'epingles', 'derniereVisite', 'maj',
             // L'adresse, recopiée ici pour que le serveur retrouve les
             // préférences d'envoi. Elle ne peut être que la sienne.
             'email',
             // La date de ses premiers pas (l'accueil du Hub) : l'équipe
             // sait qui a fait le tour de son espace.
             'accueil'
           ])
        && (!('accueil' in request.resource.data) || request.resource.data.accueil is timestamp)
        && (!('email' in request.resource.data) || request.resource.data.email == monEmail())
        && (!('nom' in request.resource.data) || texteBorne(request.resource.data.nom, 120))
        && (!('telephone' in request.resource.data) || texteBorne(request.resource.data.telephone, 40))
        && (!('entreprise' in request.resource.data) || texteBorne(request.resource.data.entreprise, 120))
        && (!('epingles' in request.resource.data) || (request.resource.data.epingles is list && request.resource.data.epingles.size() <= 50));
    }

    // Les notes du client (« Vos notes », sur l'accueil du Hub). Un carnet
    // personnel : une note appartient à qui l'a écrite (uid), et personne
    // d'autre ne la lit, pas même l'équipe. Quand le client la partage
    // (partagee), l'équipe du projet rattaché la lit ; sa requête doit le
    // dire (where partagee == true) : une note privée demandée par
    // l'équipe est refusée, par son adresse comme en liste. Une collection
    // à part, et non une sous-collection « notes » du profil : le nom
    // « notes » est déjà celui des décisions d'un projet, et une lecture en
    // groupe de l'équipe aurait ouvert les deux d'un coup.
    match /notesClient/{noteId} {
      function noteDuClient(d) {
        return d.keys().hasOnly(['uid', 'nom', 'projet', 'texte', 'epinglee', 'partagee', 'cree', 'maj'])
            && d.uid == moi()
            && texteBorne(d.nom, 120)
            && texteRequis(d.texte, 4000)
            && texteBorne(d.projet, 80)
            && d.epinglee is bool
            && d.partagee is bool
            && d.cree is timestamp
            && d.maj == request.time
            // Partagée, une note est rattachée à un projet dont le client
            // est membre : rien ne part vers l'équipe d'un autre projet.
            && (d.partagee == false || (d.projet != '' && membreDuProjet(d.projet)));
      }
      // Le propriétaire lit les siennes.
      allow read: if connecte() && resource.data.uid == moi();
      // L'équipe du projet lit celles qui lui sont partagées, rien d'autre.
      allow read: if resource.data.partagee == true && equipeSurProjet(resource.data.projet);
      // Un client écrit, à son nom, une note qui naît maintenant. Ni
      // l'équipe ni un testeur n'ont de carnet ici.
      allow create: if connecte() && !estEquipe() && request.auth.token.get('testeur', false) != true
        && noteDuClient(request.resource.data)
        && request.resource.data.cree == request.time;
      allow update: if connecte() && resource.data.uid == moi()
        && noteDuClient(request.resource.data)
        && request.resource.data.cree == resource.data.cree;
      allow delete: if connecte() && resource.data.uid == moi();
    }

    // Une organisation regroupe des projets ; elle ne donne aucun accès.
    // Ses « membres » sont déduits des accès aux projets, par le serveur,
    // pour que chacun lise la fiche de sa propre société.
    // Une société : l'administrateur, un agent qui travaille sur l'un de ses
    // projets (« projets », tenu par le serveur) ou à qui la gestion des
    // clients est déléguée, et les clients qui ont accès à l'un de ses
    // projets. Un agent ne lit pas les clients des autres.
    match /organisations/{orgId} {
      allow read:  if estAdmin()
                   || (estEquipe() && (resource.data.get('projets', []).hasAny(ficheEquipe().get('projets', []))
                                       || ficheEquipe().get('permissions', []).hasAny(['clients.gerer'])))
                   || (connecte() && moi() in resource.data.get('membres', []));
      allow write: if false;
    }

    // ================================================================
    // Les données internes, hors des documents que le client lit
    //
    // Firestore sert un document ENTIER : un champ « interne » posé sur une
    // fiche lisible par le client lui est lisible, quoi qu'affiche l'écran.
    // Ce qui est réservé à Capmedia vit donc dans ces collections à part,
    // que seule l'équipe lit.
    // ================================================================

    // Les notes internes d'une organisation : commerciales, administrateurs
    // seuls. Écrites par le serveur.
    match /organisationsInternes/{orgId} {
      allow read:  if estAdmin();
      allow write: if false;
    }

    // La santé d'un projet, et les arbitrages d'accès laissés par la
    // migration (écrits par le serveur). L'équipe du projet la lit et règle
    // la santé. Le budget n'y vit plus (budgets/) : une fiche d'avant la
    // migration qui le porterait encore ne se lit qu'avec la finance.
    match /projetsInternes/{projetId} {
      allow read:  if financeEquipe(projetId)
                   || (equipeSurProjet(projetId) && !('budget' in resource.data) && !('budgetNote' in resource.data));
      allow write: if equipeSurProjet(projetId)
        && (resource == null ? request.resource.data.keys() : request.resource.data.diff(resource.data).affectedKeys())
             .hasOnly(['sante', 'maj'])
        && (!('sante' in request.resource.data) || request.resource.data.sante in ['ok', 'attention', 'bloque']);
    }

    // Le budget d'un projet et sa note : de la finance interne. Écrits par
    // le serveur, lus par qui a la finance du projet.
    match /budgets/{projetId} {
      allow read:  if financeEquipe(projetId);
      allow write: if false;
    }

    // La note interne d'un paiement. Écrite par le serveur.
    match /paiementsInternes/{paiementId} {
      allow read:  if estAdmin();
      allow write: if false;
    }

    // ================================================================
    // Les projets et leurs sous-collections
    // ================================================================

    match /projets/{projetId} {
      allow read:  if equipeSurProjet(projetId) || (connecte() && moi() in resource.data.get('membres', []));
      allow create, delete: if false;

      // Un agent du projet tient l'avancement ; il ne touche ni à
      // l'identité, ni au client, ni au rangement du projet.
      allow update: if equipeSurProjet(projetId) && !estAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'statut', 'progression', 'pulse', 'cible', 'debut', 'reports', 'description', 'maj',
             // Le pouls est daté et signé : le client lit « mis à jour le … par … ».
             'pulseMaj', 'pulsePar'
           ])
        && (!('reports' in request.resource.data)
            || (request.resource.data.reports is list && request.resource.data.reports.size() <= 20))
        && request.resource.data.statut in ['brouillon', 'prospect', 'devis-envoye', 'devis-signe',
                                            'cadrage', 'planifie', 'en-cours', 'attente-client',
                                            'en-revue', 'livraison', 'maintenance', 'termine', 'suspendu', 'archive'];

      // L'administrateur pilote le contenu du projet. L'identité et l'accès
      // (référence, membres, rôles, personnes, ouverture, e-mails du client,
      // compteur, organisation) restent au serveur : ils portent l'accès,
      // la communication et la numérotation.
      allow update: if estAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             // Ni « budget », ni « budgetNote », ni « sante » : ils vivent
             // dans projetsInternes, que le client ne lit pas.
             'nom', 'description', 'type', 'statut', 'progression', 'debut', 'cible',
             'responsable', 'pulse', 'archive', 'client', 'plateformes', 'logo', 'maj',
             'contacts', 'interne',
             // Le pouls est daté et signé : le client lit « mis à jour le … par … ».
             'pulseMaj', 'pulsePar',
             // L'histoire de la date cible : chaque report, son motif, sa
             // date et son auteur. Le client la lit, c'est tout l'objet.
             'reports',
             // Rangé dans « Projets à faire » : une idée, ou un projet mis
             // de côté. Un simple drapeau, qui ne touche ni au statut ni à
             // l'accès du client.
             'aFaire'
             // « ouvert », « membres », « roles », « personnes »,
             // « personnesClient » (le miroir nom + rôle que lit le client),
             // « emailsClient » et « membresOrganisation » restent absents de
             // cette liste : ouvrir, donner un accès ou couper les e-mails
             // n'appartient qu'au serveur, qui le trace.
           ])
        && (!('reports' in request.resource.data)
            || (request.resource.data.reports is list && request.resource.data.reports.size() <= 20))
        && (!('aFaire' in request.resource.data) || request.resource.data.aFaire is bool)
        && texteRequis(request.resource.data.nom, 120)
        && request.resource.data.statut in ['brouillon', 'prospect', 'devis-envoye', 'devis-signe',
                                            'cadrage', 'planifie', 'en-cours', 'attente-client',
                                            'en-revue', 'livraison', 'maintenance', 'termine', 'suspendu', 'archive'];

      // Les personnes qui ont (ou auront) accès au projet, leur rôle, leur
      // invitation. L'équipe du projet les lit ; seul le serveur les écrit.
      match /interlocuteurs/{cle} {
        allow read:   if equipeSurProjet(projetId);
        allow write:  if false;
      }

      // Une partie du projet est lue par le client : rien de technique ne
      // s'y pose (comptes, accès, dépendances vont dans technique/, juste
      // en dessous). Une règle ne masque pas un champ à la lecture : elle
      // empêche seulement qu'il revienne. Une ancienne fiche qui le porte
      // encore (avant migrer-technique.mjs) reste modifiable, sans qu'on
      // puisse en changer le contenu.
      match /composants/{composantId} {
        allow read:   if accesProjet(projetId);
        allow create: if equipeSurProjet(projetId) && !('technique' in request.resource.data);
        allow update: if equipeSurProjet(projetId)
          && !request.resource.data.diff(resource.data).addedKeys().hasAny(['technique'])
          && !request.resource.data.diff(resource.data).changedKeys().hasAny(['technique']);
        allow delete: if equipeSurProjet(projetId);
      }

      // La fiche technique d'une brique : comptes, accès, dépendances et
      // leurs versions. Rien de cela ne regarde le client, et le masquer à
      // l'écran ne suffisait pas : la donnée partait quand même.
      match /technique/{composantId} {
        allow read:   if equipeSurProjet(projetId);
        allow write:  if equipeSurProjet(projetId);
      }

      // Une étape ne porte pas de montant : celui d'une étape de devis vit
      // dans montants/, lu par la seule finance. Personne n'en pose ni n'en
      // change un sur l'étape. Un montant d'avant la migration, encore là
      // (l'ancien écran l'a réécrit pendant la bascule), ne bloque pas la
      // modification de l'étape : la migration de rattrapage le déplace.
      match /jalons/{jalonId} {
        allow read:   if accesProjet(projetId);
        allow create: if equipeSurProjet(projetId) && !('montant' in request.resource.data);
        allow update: if equipeSurProjet(projetId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['montant']);
        allow delete: if equipeSurProjet(projetId);
      }

      // Les montants liés au projet : une étape de devis (« jalon-<id> »),
      // le prix du forfait de maintenance (« maintenance »). La finance de
      // l'équipe et le responsable les lisent ; la finance les écrit.
      match /montants/{montantId} {
        allow read:   if financeEquipe(projetId) || responsableDuProjet(projetId);
        allow create, update: if financeGerer(projetId)
          && request.resource.data.keys().hasOnly(['projet', 'montant', 'maj'])
          && request.resource.data.projet == projetId
          && (request.resource.data.montant == null || request.resource.data.montant is number);
        allow delete: if financeGerer(projetId);
      }

      // La maintenance continue : le contrat (document « contrat »), puis
      // les séquences, les journées et les évolutions, dans la même
      // collection. Le client lit tout : c'est son espace. Il n'écrit que
      // sa demande de forfait et ses propositions d'évolution ; les
      // modalités, les jours, les statuts restent à l'équipe.
      match /maintenance/{docId} {
        allow read:  if accesProjet(projetId);
        // Le prix du forfait n'y figure pas : il vit dans montants/ (même
        // règle que les étapes pour un prix d'avant la migration).
        allow create: if equipeSurProjet(projetId) && !('montant' in request.resource.data);
        allow update: if equipeSurProjet(projetId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['montant']);
        allow delete: if equipeSurProjet(projetId);

        // Le client demande un forfait : il crée le contrat avec sa seule
        // demande, ou le remet en « demandé » quand le précédent s'est
        // arrêté. Un forfait proposé ou en cours ne se réécrit pas par lui.
        allow create: if membreDuProjet(projetId)
          && docId == 'contrat'
          && request.resource.data.keys().hasOnly(['genre', 'statut', 'demande', 'cree', 'maj'])
          && request.resource.data.genre == 'contrat'
          && request.resource.data.statut == 'demande'
          && demandeDeForfait(request.resource.data.demande);
        allow update: if membreDuProjet(projetId)
          && docId == 'contrat'
          && resource.data.statut in ['demande', 'suspendu', 'termine']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'demande', 'maj'])
          && request.resource.data.statut == 'demande'
          && demandeDeForfait(request.resource.data.demande);

        // Le client propose une évolution : un titre, une description, des
        // pièces jointes, et c'est tout. Le statut et l'origine sont
        // imposés, l'équipe tranche.
        allow create: if membreDuProjet(projetId)
          && docId != 'contrat'
          && request.resource.data.keys().hasOnly(['genre', 'titre', 'description', 'statut', 'origine', 'par', 'pieces', 'cree', 'maj'])
          && request.resource.data.genre == 'evolution'
          && request.resource.data.statut == 'proposee'
          && request.resource.data.origine == 'client'
          && request.resource.data.par.uid == moi()
          && texteRequis(request.resource.data.titre, 160)
          && texteBorne(request.resource.data.description, 4000)
          && (!('pieces' in request.resource.data)
              || (request.resource.data.pieces is list && request.resource.data.pieces.size() <= 10));
        // Il retire sa propre proposition tant que rien n'est décidé : une
        // évolution acceptée, planifiée ou écartée reste dans l'histoire.
        allow delete: if membreDuProjet(projetId)
          && docId != 'contrat'
          && resource.data.genre == 'evolution'
          && resource.data.origine == 'client'
          && resource.data.statut == 'proposee'
          && resource.data.par.uid == moi();
      }

      match /liens/{lienId} {
        allow read:   if accesProjet(projetId) && visiblePourMoi();
        // Un lien de catégorie « acces » peut porter un identifiant (jamais
        // un mot de passe) : un texte court, écrit par l'équipe seule.
        allow write:  if equipeSurProjet(projetId)
          && request.resource.data.url is string
          && request.resource.data.url.matches('https?://.*')
          && (!('identifiants' in request.resource.data) || texteBorne(request.resource.data.identifiants, 300));
      }

      // La conversation du projet : deux voix, jamais de note interne ici.
      // Le texte peut être vide quand des pièces l'accompagnent : un envoi
      // de pièces seules n'invente pas un mot à leur place.
      match /messages/{messageId} {
        allow read: if accesProjet(projetId);
        allow create: if accesProjet(projetId)
          && request.resource.data.keys().hasOnly(['de', 'texte', 'pieces', 'date'])
          && auteurCoherent(request.resource.data.de)
          && request.resource.data.pieces is list
          && request.resource.data.pieces.size() <= 10
          && (texteRequis(request.resource.data.texte, 6000)
              || (texteBorne(request.resource.data.texte, 6000) && request.resource.data.pieces.size() > 0));
        allow update, delete: if false;
      }

      // L'accusé de lecture : chacun tient le sien, les deux le lisent. Il
      // porte l'instant de la dernière lecture et celui de la dernière
      // frappe, rien d'autre : aucun texte n'y transite.
      match /lectures/{personneId} {
        allow read:   if accesProjet(projetId);
        allow write:  if accesProjet(projetId)
          && request.auth.uid == personneId
          && request.resource.data.keys().hasOnly(['lu', 'frappe', 'cote', 'nom']);
      }
    }

    // Les jalons se lisent aussi en groupe, pour le planning de l'équipe.
    // Tous les projets d'un coup : les administrateurs. Un agent lit projet
    // par projet, sous ses projets.
    match /{chemin=**}/jalons/{jalonId} {
      allow read: if estAdmin();
    }

    // La maintenance de tous les projets d'un coup, pour le cockpit.
    match /{chemin=**}/montants/{montantId} {
      allow read: if estAdmin();
    }

    match /{chemin=**}/maintenance/{docId} {
      allow read: if estAdmin();
    }

    // ================================================================
    // Le coffre-fort d'un projet
    //
    // Les accès du client (sites, consoles, stores), chiffrés dans le
    // navigateur avant d'arriver ici (assets/js/coffre-chiffre.js). La base
    // ne voit que des octets : ni secret, ni phrase, ni clé qu'on en
    // tirerait sans elle. Ces règles disent QUI touche aux octets, et
    // quelle FORME ils ont : aucun champ en clair ne peut s'y glisser.
    //
    // Qui : l'équipe du projet (administrateur, ou agent affecté), et le
    // ou les responsables du projet côté client. Jamais un collaborateur,
    // jamais un autre client, jamais un testeur.
    // ================================================================

    function accesCoffre(projetId) {
      return equipeSurProjet(projetId)
          || (responsableDuProjet(projetId) && request.auth.token.get('testeur', false) != true);
    }

    // La marque d'une personne qui connaît la clé en cours : son côté et
    // son uid. Le coffre garde la liste (« porteurs ») pour qu'on sache
    // quand renouveler la clé : quelqu'un qui l'a connue a perdu l'accès.
    function marqueCoffre() {
      return (estEquipe() ? 'equipe:' : 'client:') + moi();
    }

    function refCoffre(projetId) {
      return /databases/$(database)/documents/coffres/$(projetId);
    }

    // Du base64url, d'une longueur bornée : la seule forme d'un chiffré.
    function octets(valeur, min, max) {
      return valeur is string && valeur.size() >= min && valeur.size() <= max
          && valeur.matches('^[A-Za-z0-9_-]+$');
    }

    // L'enveloppe de la clé du coffre : PBKDF2-SHA256, entre 600 000 et
    // 2 000 000 tours (au-delà, une enveloppe piégée bloquerait la page de
    // qui l'ouvre), sel de 16 octets, IV de 12, clé de 32 octets plus
    // l'étiquette.
    function enveloppeValide(d) {
      return d.version == 1
          && d.kdf == 'PBKDF2-SHA256'
          && d.iterations is int && d.iterations >= 600000 && d.iterations <= 2000000
          && octets(d.sel, 22, 22)
          && octets(d.iv, 16, 16)
          && octets(d.cle, 64, 64);
    }

    // Toute enveloppe posée sur le coffre est aussi archivée, dans le même
    // lot, sous son numéro : en cas de sabotage, on retrouve la précédente.
    function enveloppeArchivee(projetId, d) {
      let a = getAfter(/databases/$(database)/documents/coffres/$(projetId)/enveloppes/$(string(d.enveloppe))).data;
      return a.cle == d.cle && a.sel == d.sel && a.iv == d.iv && a.iterations == d.iterations;
    }

    match /coffres/{projetId} {
      allow read: if accesCoffre(projetId);
      // L'équipe ouvre le coffre et génère la phrase. Une création ne peut
      // pas écraser un coffre existant (ce serait une mise à jour).
      allow create: if equipeSurProjet(projetId)
        && request.resource.data.keys().hasOnly(['version', 'kdf', 'iterations', 'sel', 'iv', 'cle', 'enveloppe', 'porteurs', 'creePar', 'cree', 'maj', 'phraseLe'])
        && request.resource.data.keys().hasAll(['version', 'kdf', 'iterations', 'sel', 'iv', 'cle', 'enveloppe', 'porteurs', 'creePar', 'cree', 'maj', 'phraseLe'])
        && enveloppeValide(request.resource.data)
        && request.resource.data.enveloppe is int && request.resource.data.enveloppe >= 1
        && enveloppeArchivee(projetId, request.resource.data)
        && request.resource.data.porteurs == [marqueCoffre()]
        && request.resource.data.creePar == moi()
        && request.resource.data.cree == request.time
        && request.resource.data.maj == request.time
        && request.resource.data.phraseLe == request.time;
      // Nouvelle phrase, nouvelle clé : l'enveloppe change, son numéro
      // monte d'un, elle est archivée, et seul son auteur connaît la clé.
      // L'équipe du projet ou le responsable, comme pour le reste.
      allow update: if accesCoffre(projetId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['iterations', 'sel', 'iv', 'cle', 'enveloppe', 'porteurs', 'maj', 'phraseLe'])
        && enveloppeValide(request.resource.data)
        && request.resource.data.enveloppe == resource.data.enveloppe + 1
        && enveloppeArchivee(projetId, request.resource.data)
        && request.resource.data.porteurs == [marqueCoffre()]
        && request.resource.data.maj == request.time
        && request.resource.data.phraseLe == request.time;
      // Qui ouvre le coffre s'ajoute, lui seul, aux porteurs de la clé.
      allow update: if accesCoffre(projetId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['porteurs'])
        && !(marqueCoffre() in resource.data.porteurs)
        && marqueCoffre() in request.resource.data.porteurs
        && request.resource.data.porteurs.hasAll(resource.data.porteurs)
        && request.resource.data.porteurs.size() == resource.data.porteurs.size() + 1
        && request.resource.data.porteurs.size() <= 200;
      // La phrase perdue : l'équipe efface et recommence.
      allow delete: if equipeSurProjet(projetId);

      // Les enveloppes, en ajout seul : ni corrigées, ni effacées, même
      // quand le coffre l'est. Chacune n'existe qu'avec le coffre qui la porte.
      match /enveloppes/{numero} {
        allow read: if accesCoffre(projetId);
        allow create: if accesCoffre(projetId)
          && request.resource.data.keys().hasOnly(['version', 'kdf', 'iterations', 'sel', 'iv', 'cle', 'par', 'date'])
          && request.resource.data.keys().hasAll(['version', 'kdf', 'iterations', 'sel', 'iv', 'cle', 'par', 'date'])
          && request.resource.data.par == moi()
          && request.resource.data.date == request.time
          && getAfter(refCoffre(projetId)).data.enveloppe == int(numero)
          && getAfter(refCoffre(projetId)).data.cle == request.resource.data.cle;
        allow update, delete: if false;
      }

      // Une entrée : g, la génération de la clé (le numéro de l'enveloppe en
      // cours), et n, sa version, qui monte d'un à chaque écriture. Les deux
      // sont authentifiés par le chiffrement : une version antérieure remise
      // en base ne se déchiffre plus, une écriture faite avec l'ancienne clé
      // pendant un renouvellement est refusée.
      match /entrees/{entreeId} {
        allow read: if accesCoffre(projetId);
        allow create: if accesCoffre(projetId)
          && request.resource.data.keys().hasOnly(['v', 'g', 'n', 'iv', 'donnees', 'cree', 'maj'])
          && request.resource.data.keys().hasAll(['v', 'g', 'n', 'iv', 'donnees', 'cree', 'maj'])
          && request.resource.data.v == 1
          && request.resource.data.n == 1
          && request.resource.data.g == getAfter(refCoffre(projetId)).data.enveloppe
          && octets(request.resource.data.iv, 16, 16)
          && octets(request.resource.data.donnees, 300, 40000)
          && request.resource.data.cree == request.time
          && request.resource.data.maj == request.time;
        allow update: if accesCoffre(projetId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['g', 'n', 'iv', 'donnees', 'maj'])
          && request.resource.data.n == resource.data.n + 1
          && request.resource.data.g == getAfter(refCoffre(projetId)).data.enveloppe
          && octets(request.resource.data.iv, 16, 16)
          && octets(request.resource.data.donnees, 300, 40000)
          && request.resource.data.maj == request.time;
        allow delete: if accesCoffre(projetId);
      }

      // La copie de la clé propre à un appareil à empreinte (WebAuthn PRF),
      // pour la génération de clé en cours. Inutile sans l'appareil et le
      // doigt de son propriétaire ; chacun pose la sienne, tous la voient
      // (transparence), tous la retirent.
      match /appareils/{appareilId} {
        allow read: if accesCoffre(projetId);
        allow create: if accesCoffre(projetId)
          && request.resource.data.keys().hasOnly(['uid', 'appareil', 'credId', 'selPrf', 'iv', 'cle', 'g', 'cree'])
          && request.resource.data.keys().hasAll(['uid', 'appareil', 'credId', 'selPrf', 'iv', 'cle', 'g', 'cree'])
          && request.resource.data.uid == moi()
          && request.resource.data.g == getAfter(refCoffre(projetId)).data.enveloppe
          && texteBorne(request.resource.data.appareil, 80)
          && octets(request.resource.data.credId, 16, 1400)
          && octets(request.resource.data.selPrf, 43, 43)
          && octets(request.resource.data.iv, 16, 16)
          && octets(request.resource.data.cle, 64, 64)
          && request.resource.data.cree == request.time;
        allow update: if false;
        allow delete: if accesCoffre(projetId);
      }

      // Le journal : qui a ouvert, quand, comment. Aucun contenu, aucun nom
      // (l'écran le prend dans l'annuaire). Chacun n'écrit que sa propre
      // ligne, datée par le serveur ; personne ne la corrige ni ne l'efface.
      match /journal/{ligneId} {
        allow read: if accesCoffre(projetId);
        allow create: if accesCoffre(projetId)
          && request.resource.data.keys().hasOnly(['uid', 'cote', 'action', 'moyen', 'date'])
          && request.resource.data.keys().hasAll(['uid', 'cote', 'action', 'moyen', 'date'])
          && request.resource.data.uid == moi()
          && request.resource.data.cote == (estEquipe() ? 'equipe' : 'client')
          && request.resource.data.action in ['creation', 'deverrouillage', 'echec', 'cle-renouvelee',
                                              'entree-ajoutee', 'entree-modifiee', 'entree-supprimee',
                                              'appareil-ajoute', 'appareil-retire', 'coffre-efface']
          && request.resource.data.moyen in ['phrase', 'appareil', '']
          && request.resource.data.date == request.time;
        allow update, delete: if false;
      }
    }

    // ================================================================
    // Les demandes (collection « tickets »)
    // ================================================================

    match /tickets/{ticketId} {

      function ficheTicket() {
        return get(/databases/$(database)/documents/tickets/$(ticketId)).data;
      }

      function valeursConnues() {
        return request.resource.data.type in ['bug', 'modification', 'fonctionnalite', 'amelioration', 'question',
                                              'technique', 'contenu', 'devis', 'demande', 'autre']
            && request.resource.data.urgence in ['bloquant', 'critique', 'important', 'mineur']
            && request.resource.data.plateforme in ['ios', 'android', 'web', 'admin', 'backend', 'landing', ''];
      }

      function taillesTenues() {
        return texteRequis(request.resource.data.titre, 120)
            && texteRequis(request.resource.data.description, 6000)
            && texteBorne(request.resource.data.etapes, 4000)
            && texteBorne(request.resource.data.attendu, 2000)
            && texteBorne(request.resource.data.obtenu, 2000)
            && texteBorne(request.resource.data.contexte, 2000)
            && texteBorne(request.resource.data.appareil, 160)
            && texteBorne(request.resource.data.version, 40)
            && texteBorne(request.resource.data.composant, 80)
            && request.resource.data.liens is list
            && request.resource.data.liens.size() <= 10
            && request.resource.data.pieces is list
            && request.resource.data.pieces.size() <= 10;
      }

      // Une demande de rendez-vous : le jour (AAAA-MM-JJ), le créneau, l'heure
      // quand le client en donne une (HH:MM), le sujet. Rien d'autre.
      function rendezVousValide() {
        return !('rendezVous' in request.resource.data)
            || (request.resource.data.rendezVous is map
                && request.resource.data.rendezVous.keys().hasOnly(['date', 'creneau', 'heure', 'sujet'])
                && request.resource.data.rendezVous.date is string
                && request.resource.data.rendezVous.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                && request.resource.data.rendezVous.creneau in ['matin', 'apres-midi', 'heure']
                && request.resource.data.rendezVous.get('heure', '') is string
                && (request.resource.data.rendezVous.get('heure', '') == ''
                    || request.resource.data.rendezVous.heure.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
                && (request.resource.data.rendezVous.creneau != 'heure' || request.resource.data.rendezVous.get('heure', '') != '')
                && texteRequis(request.resource.data.rendezVous.get('sujet', ''), 100));
      }

      // Création : le numéro est posé par la fonction, jamais par le client.
      // L'auteur est forcément celui qui écrit.
      function creationValide() {
        return request.resource.data.keys().hasOnly([
                 'numero', 'projet', 'composant', 'titre', 'description', 'type', 'urgence',
                 'statut', 'plateforme', 'version', 'etapes', 'attendu', 'obtenu', 'contexte', 'appareil', 'liens',
                 'assigne', 'auteur', 'pieces', 'archive', 'cree', 'maj', 'resolu', 'lu', 'qualification', 'devis',
                 'anomalie',
                 // La demande qui en poursuit une autre (« Suite de REF-… »).
                 'suite',
                 // Une demande de rendez-vous, posée depuis le calendrier.
                 'rendezVous',
                 // La suggestion de Capmedia dont la demande est née.
                 'suggestion'
               ])
            && rendezVousValide()
            // Une demande née d'une anomalie de test porte son identifiant.
            && (!('anomalie' in request.resource.data) || texteBorne(request.resource.data.anomalie, 80))
            && (!('suggestion' in request.resource.data) || texteBorne(request.resource.data.suggestion, 80))
            && (!('suite' in request.resource.data) || request.resource.data.suite == null || request.resource.data.suite is string)
            && request.resource.data.numero == null
            && request.resource.data.statut == 'nouveau'
            && request.resource.data.archive == false
            && request.resource.data.assigne == null
            && request.resource.data.resolu == null
            && request.resource.data.qualification == null
            && request.resource.data.devis == null
            && request.resource.data.auteur.uid == moi()
            && request.resource.data.auteur.email == monEmail()
            && request.resource.data.projet is string
            && valeursConnues()
            && taillesTenues();
      }

      // L'équipe pilote : statut, urgence, assignation, qualification,
      // archive, lecture. Le numéro, le projet, l'auteur et la date de
      // création sont figés.
      function majEquipe() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['statut', 'urgence', 'assigne', 'archive', 'maj', 'resolu', 'lu', 'titre',
                           'type', 'plateforme', 'pieces', 'composant', 'qualification', 'devis',
                           // La version qui porte la correction : le client
                           // la demandait par message, faute de la lire.
                           'release',
                           // Le motif d'un refus : le client le lit dans le bandeau.
                           'motifRefus'])
            && request.resource.data.statut in ['nouveau', 'a-analyser', 'en-attente-client', 'acceptee', 'planifiee',
                                                'en-cours', 'en-revue', 'a-valider', 'resolu', 'refuse', 'annulee', 'ferme']
            && (request.resource.data.get('motifRefus', null) == null || texteBorne(request.resource.data.motifRefus, 2000))
            && request.resource.data.urgence in ['bloquant', 'critique', 'important', 'mineur']
            // Une demande née sans le champ (anciens semis) se pilote quand même.
            && (request.resource.data.get('qualification', null) == null
                || request.resource.data.qualification in ['incluse', 'hors-perimetre', 'a-chiffrer', 'offerte']);
      }

      // Le client ne fait que quatre choses : marquer comme lu, valider une
      // correction, rouvrir dans les sept jours, ajouter des pièces.
      function clientMarqueLu() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lu']);
      }

      function clientValide() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['statut', 'maj', 'resolu', 'lu'])
            && resource.data.statut == 'a-valider'
            && request.resource.data.statut == 'resolu';
      }

      function clientRouvre() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['statut', 'maj', 'lu'])
            && resource.data.statut == 'resolu'
            && request.resource.data.statut == 'en-cours'
            && resource.data.resolu != null
            && request.time < resource.data.resolu + duration.value(7, 'd');
      }

      // « Pas tout à fait » : la correction livrée ne tient pas, la demande
      // repasse en cours, chez nous. Avant, ce bouton ne faisait rien.
      function clientConteste() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['statut', 'maj', 'lu'])
            && resource.data.statut == 'a-valider'
            && request.resource.data.statut == 'en-cours';
      }

      function ajoutPieces() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pieces', 'maj'])
            && request.resource.data.pieces is list
            && request.resource.data.pieces.size() <= 10;
      }

      // « Je n'en ai plus besoin » : le client retire sa demande tant
      // qu'elle est ouverte et chez nous. Une fois le travail commencé, il
      // nous écrit, il ne l'annule plus seul.
      function clientAnnule() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['statut', 'maj', 'lu'])
            && resource.data.statut in ['nouveau', 'a-analyser', 'acceptee', 'planifiee']
            && request.resource.data.statut == 'annulee';
      }

      allow read: if equipeSurProjet(resource.data.projet) || membreDuProjet(resource.data.projet);

      allow create: if creationValide()
                    && (equipeSurProjet(request.resource.data.projet) || membreDuProjet(request.resource.data.projet));

      allow update: if estEquipe()
                      ? (equipeSurProjet(resource.data.projet) && majEquipe())
                      : (membreDuProjet(resource.data.projet)
                         && (clientMarqueLu() || clientValide() || clientRouvre() || clientConteste() || ajoutPieces() || clientAnnule()));

      allow delete: if false;

      // Une note interne est invisible au client : les règles la refusent,
      // le client interroge la sous-collection avec interne == false.
      match /messages/{messageId} {
        allow read: if equipeSurProjet(ficheTicket().projet)
                    || (membreDuProjet(ficheTicket().projet) && resource.data.interne == false);

        allow create: if (equipeSurProjet(ficheTicket().projet) || membreDuProjet(ficheTicket().projet))
          && request.resource.data.keys().hasOnly(['de', 'texte', 'pieces', 'interne', 'date'])
          && auteurCoherent(request.resource.data.de)
          && request.resource.data.interne == (estEquipe() ? request.resource.data.interne : false)
          && texteRequis(request.resource.data.texte, 6000)
          && request.resource.data.pieces is list
          && request.resource.data.pieces.size() <= 10;

        allow update, delete: if false;
      }

      // Le journal d'audit : lecture seule, écrit par les fonctions.
      match /evenements/{evenementId} {
        allow read:  if equipeSurProjet(ficheTicket().projet) || membreDuProjet(ficheTicket().projet);
        allow write: if false;
      }
    }

    // ================================================================
    // Les tâches : l'équipe écrit, le client lit ce qui lui est destiné
    // ================================================================

    match /taches/{tacheId} {
      // Le client répond sur une tâche qui l'attend, depuis sa fiche : sa
      // réponse (texte, pièces) et le statut « réponse reçue », une fois,
      // sur une tâche visible et en attente de lui. Rien d'autre ne bouge.
      function clientRepondTache() {
        return resource.data.visibilite == 'client'
            && resource.data.statut == 'attente-client'
            && request.resource.data.statut == 'repondu'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reponseClient', 'statut', 'maj'])
            && request.resource.data.reponseClient.par == moi()
            && texteBorne(request.resource.data.reponseClient.texte, 4000)
            && request.resource.data.reponseClient.pieces is list
            && request.resource.data.reponseClient.pieces.size() <= 10
            && (request.resource.data.reponseClient.texte.size() > 0 || request.resource.data.reponseClient.pieces.size() > 0);
      }

      allow read: if equipeSurProjet(resource.data.projet)
                  || (membreDuProjet(resource.data.projet) && resource.data.visibilite == 'client');
      allow create: if equipeSurProjet(request.resource.data.projet)
        && texteRequis(request.resource.data.titre, 160)
        && request.resource.data.statut in ['a-faire', 'en-cours', 'en-revue', 'bloquee', 'attente-client', 'repondu', 'terminee']
        && request.resource.data.priorite in ['faible', 'normale', 'importante', 'bloquante']
        && request.resource.data.visibilite in ['client', 'interne']
        && request.resource.data.projet is string;
      allow update: if estEquipe()
        ? (equipeSurProjet(resource.data.projet)
           && (!('statut' in request.resource.data) || request.resource.data.statut in ['a-faire', 'en-cours', 'en-revue', 'bloquee', 'attente-client', 'repondu', 'terminee'])
           && (!('visibilite' in request.resource.data) || request.resource.data.visibilite in ['client', 'interne'])
           && request.resource.data.projet == resource.data.projet)
        : (membreDuProjet(resource.data.projet) && clientRepondTache());
      allow delete: if equipeSurProjet(resource.data.projet);
    }

    // ================================================================
    // Les validations : l'équipe demande, le client répond une fois
    // ================================================================

    // Une validation « réservée au responsable » (reserveeResponsable)
    // engage le client : le collaborateur la lit, seul le responsable y
    // répond. Les autres, tout interlocuteur du projet y répond.
    match /validations/{validationId} {
      allow read: if equipeSurProjet(resource.data.projet) || membreDuProjet(resource.data.projet);
      allow create: if equipeSurProjet(request.resource.data.projet)
        && texteRequis(request.resource.data.titre, 160)
        && request.resource.data.statut == 'en-attente'
        && request.resource.data.projet is string
        && (!('reserveeResponsable' in request.resource.data) || request.resource.data.reserveeResponsable is bool);
      // L'équipe tient la demande (titre, pièces, annulation) mais ne
      // répond jamais à la place du client : ni « reponse », ni statut
      // approuvé ou à modifier.
      allow update: if estEquipe()
        ? (equipeSurProjet(resource.data.projet) && request.resource.data.projet == resource.data.projet
           && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reponse'])
           && (request.resource.data.statut == resource.data.statut || request.resource.data.statut in ['en-attente', 'annulee']))
        : (membreDuProjet(resource.data.projet)
           && resource.data.statut == 'en-attente'
           && (resource.data.get('reserveeResponsable', false) != true || responsableDuProjet(resource.data.projet))
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'reponse', 'maj'])
           && request.resource.data.statut in ['approuvee', 'modifications']
           && request.resource.data.reponse.par == moi()
           && texteBorne(request.resource.data.reponse.commentaire, 4000)
           // Ses remarques peuvent porter des pièces (dix au plus), rangées
           // sous projets/{p}/validations/{vid}/reponse/ dans le Storage.
           && (!('pieces' in request.resource.data.reponse)
               || (request.resource.data.reponse.pieces is list && request.resource.data.reponse.pieces.size() <= 10)));
      allow delete: if false;
    }

    // ================================================================
    // Les fichiers : l'équipe range tout, le client dépose dans ses
    // catégories, en visibilité client, à son nom
    // ================================================================

    match /fichiers/{fichierId} {
      function categoriesClient() {
        return ['assets', 'logos', 'captures', 'cahier', 'autres'];
      }
      allow read: if equipeSurProjet(resource.data.projet)
                  || (membreDuProjet(resource.data.projet) && resource.data.visibilite == 'client');
      allow create: if request.resource.data.keys().hasOnly([
             'projet', 'composant', 'categorie', 'nom', 'chemin', 'taille', 'type', 'description',
             'tags', 'par', 'visibilite', 'version', 'archive', 'cree'
           ])
        && texteRequis(request.resource.data.nom, 240)
        && texteRequis(request.resource.data.chemin, 500)
        // Le fichier stocké porte l'identifiant de SA fiche : c'est elle que
        // les règles Storage relisent pour décider qui le télécharge.
        && request.resource.data.chemin.matches('projets/' + request.resource.data.projet + '/fichiers/' + fichierId + '/.+')
        && request.resource.data.par.uid == moi()
        && request.resource.data.archive == false
        && (equipeSurProjet(request.resource.data.projet)
            || (!estEquipe() && membreDuProjet(request.resource.data.projet)
                && request.resource.data.categorie in categoriesClient()
                && request.resource.data.visibilite == 'client'
                && request.resource.data.par.cote == 'client'));
      allow update: if equipeSurProjet(resource.data.projet)
        && request.resource.data.projet == resource.data.projet
        && request.resource.data.chemin == resource.data.chemin;
      // Le client retire ce qu'il a lui-même déposé, et rien d'autre :
      // l'équipe archive, elle n'efface pas.
      allow delete: if !estEquipe()
        && membreDuProjet(resource.data.projet)
        && resource.data.visibilite == 'client'
        && resource.data.par.uid == moi();
    }

    // ================================================================
    // Versions, réunions, notes, blocages : l'équipe écrit, le client lit
    // ce qui lui est destiné
    // ================================================================

    match /releases/{releaseId} {
      allow read: if equipeSurProjet(resource.data.projet)
                  || (membreDuProjet(resource.data.projet) && resource.data.visibilite == 'client');
      allow create: if request.resource.data.projet is string && equipeSurProjet(request.resource.data.projet)
        && request.resource.data.statut in ['developpement', 'test', 'soumise', 'revue', 'disponible', 'retiree']
        && (!('build' in request.resource.data) || texteBorne(request.resource.data.build, 40));
      allow update: if equipeSurProjet(resource.data.projet) && request.resource.data.projet == resource.data.projet
        && (!('build' in request.resource.data) || texteBorne(request.resource.data.build, 40));
      allow delete: if equipeSurProjet(resource.data.projet);
    }

    match /reunions/{reunionId} {
      allow read: if equipeSurProjet(resource.data.projet)
                  || (membreDuProjet(resource.data.projet) && resource.data.visibilite == 'client');
      allow create: if request.resource.data.projet is string && equipeSurProjet(request.resource.data.projet) && texteRequis(request.resource.data.titre, 160);
      allow update: if equipeSurProjet(resource.data.projet) && request.resource.data.projet == resource.data.projet;
      // Le client coche ses actions : il n'écrit que la liste « actions »,
      // qui garde sa taille (ni ajout ni retrait). Le reste de la réunion
      // (titre, date, compte rendu, décisions) reste à l'équipe. Les règles
      // ne savent pas parcourir une liste : on ne vérifie pas que seul
      // « fait » a bougé, on borne ce qui peut l'être.
      allow update: if membreDuProjet(resource.data.projet) && resource.data.visibilite == 'client'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actions'])
        && request.resource.data.actions is list
        && request.resource.data.actions.size() == resource.data.get('actions', []).size()
        && request.resource.data.actions.size() <= 50;
      allow delete: if equipeSurProjet(resource.data.projet);
    }

    match /notes/{noteId} {
      allow read: if equipeSurProjet(resource.data.projet)
                  || (membreDuProjet(resource.data.projet) && resource.data.visibilite == 'client');
      allow create: if request.resource.data.projet is string && equipeSurProjet(request.resource.data.projet) && texteRequis(request.resource.data.titre, 160);
      allow update: if equipeSurProjet(resource.data.projet) && request.resource.data.projet == resource.data.projet;
      allow delete: if equipeSurProjet(resource.data.projet);
    }

    match /blocages/{blocageId} {
      // « C'est fait » : le client dit qu'un point bloquant DE SON CÔTÉ
      // est réglé, une fois, tant qu'il n'est pas levé. L'équipe lève.
      function clientSignaleFait() {
        return resource.data.visibilite == 'client'
            && resource.data.responsable == 'client'
            && resource.data.get('resolu', null) == null
            && resource.data.get('signaleFait', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signaleFait', 'maj'])
            && request.resource.data.signaleFait.par == moi()
            && (!('texte' in request.resource.data.signaleFait) || texteBorne(request.resource.data.signaleFait.texte, 2000));
      }

      allow read: if equipeSurProjet(resource.data.projet)
                  || (membreDuProjet(resource.data.projet) && resource.data.visibilite == 'client');
      allow create: if request.resource.data.projet is string && equipeSurProjet(request.resource.data.projet) && texteRequis(request.resource.data.titre, 160);
      allow update: if estEquipe()
        ? (equipeSurProjet(resource.data.projet) && request.resource.data.projet == resource.data.projet)
        : (membreDuProjet(resource.data.projet) && clientSignaleFait());
      allow delete: if equipeSurProjet(resource.data.projet);
    }

    // ================================================================
    // Les pièces comptables et les paiements
    // ================================================================

    // Déposés par le serveur. Le client lit, marque un devis consulté et y
    // répond. Il ne touche jamais un montant, un numéro ni une facture.
    match /documents/{documentId} {
      // Un brouillon ne se lit que par l'équipe. La requête du client porte
      // donc un filtre sur les statuts visibles (« statut in [...] »), sans
      // quoi elle est refusée en bloc : c'est la règle qui décide, pas
      // l'écran.
      // La finance est au responsable : un collaborateur ne lit ni devis,
      // ni facture, ni paiement, et n'accepte rien.
      allow read: if financeEquipe(resource.data.projet)
        || (responsableDuProjet(resource.data.projet) && resource.data.statut != 'brouillon');

      // « J'ai réglé cette facture » : le responsable déclare un règlement
      // sur une facture due, et rien d'autre. Qui, quand, comment, combien,
      // et la date du serveur. L'équipe confirme en enregistrant le paiement.
      function reglementDeclareValide(r) {
        return r.keys().hasOnly(['par', 'nom', 'date', 'moyen', 'reference', 'montant', 'le'])
            && r.par == moi()
            && texteBorne(r.nom, 120)
            && r.date is timestamp
            && r.moyen in ['virement', 'carte', 'stripe', 'cheque', 'especes', 'autre']
            && texteBorne(r.reference, 80)
            && r.montant is number && r.montant > 0
            && r.le == request.time;
      }

      allow update: if !estEquipe()
        && responsableDuProjet(resource.data.projet)
        && (
             (resource.data.type == 'devis'
              && (
                   (resource.data.statut == 'envoye'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
                    && request.resource.data.statut == 'consulte')
                || (resource.data.statut in ['envoye', 'consulte']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'reponse'])
                    && request.resource.data.statut in ['accepte', 'refuse']
                    && request.resource.data.reponse.par == moi()
                    && texteBorne(request.resource.data.reponse.commentaire, 2000)
                    // Un devis dont la validité est passée ne s'accepte plus : il
                    // faut nous en demander un à jour.
                    && (!(resource.data.get('expiration', null) is timestamp)
                        || request.time < resource.data.expiration))
              ))
          || (resource.data.type == 'facture'
              && resource.data.statut in ['envoyee', 'a-payer', 'partielle', 'en-retard']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reglementDeclare'])
              && reglementDeclareValide(request.resource.data.reglementDeclare))
        );

      allow create, delete: if false;
    }

    // Les réglages de l'agence. « finance » : les coordonnées de règlement
    // (titulaire, IBAN, BIC, banque, mention), lues par tout client
    // connecté sur une facture due (il n'y a qu'une agence), écrites par la
    // finance de l'équipe.
    match /reglages/{cle} {
      allow read: if connecte();
      allow write: if cle == 'finance'
        && estEquipe()
        && (ficheEquipe().get('role', '') == 'admin'
            || ficheEquipe().get('permissions', []).hasAny(['finance.gerer']))
        && request.resource.data.keys().hasOnly(['titulaire', 'iban', 'bic', 'banque', 'mention', 'maj'])
        && texteBorne(request.resource.data.get('titulaire', ''), 120)
        && texteBorne(request.resource.data.get('iban', ''), 40)
        && texteBorne(request.resource.data.get('bic', ''), 16)
        && texteBorne(request.resource.data.get('banque', ''), 120)
        && texteBorne(request.resource.data.get('mention', ''), 600);
    }

    // Un paiement ne porte plus sa note interne : elle vit dans
    // paiementsInternes.
    match /paiements/{paiementId} {
      allow read:  if financeEquipe(resource.data.projet) || responsableDuProjet(resource.data.projet);
      allow write: if false;
    }

    // ================================================================
    // Les demandes de nouveau projet
    // ================================================================

    match /demandesProjet/{demandeId} {
      function ficheDemande() {
        return get(/databases/$(database)/documents/demandesProjet/$(demandeId)).data;
      }
      allow read: if estAdmin() || (connecte() && resource.data.par.uid == moi());
      allow create: if connecte()
        && request.resource.data.keys().hasOnly([
             'organisation', 'par', 'titre', 'idee', 'objectifs', 'type', 'plateformes', 'budget', 'delai',
             'description', 'fonctionnalites', 'exemples', 'liens', 'pieces', 'statut', 'projet', 'cree', 'maj'
           ])
        && request.resource.data.par.uid == moi()
        && request.resource.data.par.email == monEmail()
        && texteRequis(request.resource.data.titre, 160)
        && texteBorne(request.resource.data.idee, 6000)
        && request.resource.data.statut == 'nouvelle'
        && request.resource.data.projet == null
        && request.resource.data.pieces is list
        && request.resource.data.pieces.size() <= 10;
      // « devis » : la pièce envoyée pour cette demande, posée avec le
      // statut « Devis envoyé » ; le client y trouve son lien.
      allow update: if estAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'projet', 'devis', 'maj'])
        && request.resource.data.statut in ['nouvelle', 'discussion', 'qualification', 'estimation', 'devis', 'acceptee', 'projet', 'refusee'];
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if estAdmin() || (connecte() && ficheDemande().par.uid == moi());
        allow create: if (estAdmin() || (connecte() && !estEquipe() && ficheDemande().par.uid == moi()))
          && request.resource.data.keys().hasOnly(['de', 'texte', 'pieces', 'date'])
          && auteurCoherent(request.resource.data.de)
          && texteRequis(request.resource.data.texte, 6000)
          && request.resource.data.pieces is list
          && request.resource.data.pieces.size() <= 10;
        allow update, delete: if false;
      }
    }

    // ================================================================
    // Ce que seul le serveur écrit : activité, notifications, audit, file
    // ================================================================

    // L'activité vient des vrais événements : personne ne l'écrit à la main.
    match /activite/{activiteId} {
      // Une ligne financière (« responsable ») ne se lit, côté équipe,
      // qu'avec la finance du projet : la requête d'un agent sans elle
      // demande « visibilite in ['client', 'interne'] ».
      allow read: if estAdmin()
                  || (equipeSurProjet(resource.data.projet)
                      && (resource.data.visibilite in ['client', 'interne'] || financeEquipe(resource.data.projet)))
                  || (membreDuProjet(resource.data.projet) && activiteVisible(resource.data.projet));
      allow write: if false;
    }

    // Chacun lit sa boîte et ne fait qu'y marquer comme lu.
    // La conversation d'un testeur avec l'équipe : une par testeur, à la
    // racine, à part des messages de projet (un testeur n'est membre
    // d'aucun projet). Le serveur crée le document et tient les compteurs
    // (hubMessageTesteur) ; chacun ne remet que SON compteur à zéro.
    match /conversationsTesteurs/{testeurId} {
      allow read:   if estEquipe() || (estTesteur() && testeurId == moi());
      allow update: if (estEquipe()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nonLusEquipe'])
                        && request.resource.data.nonLusEquipe == 0)
                    || (estTesteur() && testeurId == moi()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nonLusTesteur'])
                        && request.resource.data.nonLusTesteur == 0);
      allow create, delete: if false;

      match /messages/{messageId} {
        allow read:   if estEquipe() || (estTesteur() && testeurId == moi());
        allow create: if request.resource.data.keys().hasOnly(['de', 'texte', 'pieces', 'date'])
          && texteRequis(request.resource.data.texte, 4000)
          && request.resource.data.pieces is list && request.resource.data.pieces.size() == 0
          && request.resource.data.date == request.time
          && request.resource.data.de.uid == moi()
          && ((estTesteur() && testeurId == moi() && request.resource.data.de.cote == 'testeur')
              || (estEquipe() && request.resource.data.de.cote == 'equipe'));
        allow update, delete: if false;
      }
    }

    match /boites/{uid}/notifications/{notificationId} {
      allow read: if connecte() && moi() == uid;
      allow update: if connecte() && moi() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lu']);
      allow create, delete: if false;
    }

    match /audit/{auditId} {
      allow read: if estAdmin();
      allow write: if false;
    }

    match /envois/{envoiId} {
      allow read, write: if false;
    }

    // ================================================================
    // La plateforme de tests
    //
    // Trois publics, pas deux. L'équipe pilote, le client regarde, et le
    // testeur ne voit que son propre travail. Ce dernier cloisonnement est
    // le plus important : un testeur qui verrait les réponses des autres
    // cocherait comme eux, et la campagne ne vaudrait plus rien.
    //
    // Un testeur n'est pas membre du projet : il n'a rien à faire dans les
    // demandes, les factures ou les messages. Son accès passe par une
    // revendication « testeur » posée par le serveur, et par la liste des
    // campagnes auxquelles il participe.
    // ================================================================

    // Testeur : la revendication, ET une fiche encore active. Un testeur
    // retiré perd l'accès tout de suite, sans attendre son jeton.
    function estTesteur() {
      return connecte() && request.auth.token.get('testeur', false) == true
          && exists(/databases/$(database)/documents/testeurs/$(moi()))
          && get(/databases/$(database)/documents/testeurs/$(moi())).data.get('actif', true) != false;
    }

    // Inscrit sur ce projet, d'après sa fiche du vivier. C'est le serveur
    // qui tient cette liste, au moment où on l'affecte à une campagne.
    function testeurDuProjet(projetId) {
      return estTesteur()
          && projetId in get(/databases/$(database)/documents/testeurs/$(moi())).data.projets;
    }

    function ficheCampagne(projetId, campagneId) {
      return get(/databases/$(database)/documents/projets/$(projetId)/campagnes/$(campagneId)).data;
    }

    // Affecté à cette campagne, et elle n'est pas close. Une campagne close
    // est un document d'archive : plus personne n'y écrit, pas même celui
    // qui l'a remplie.
    function testeurDeLaCampagne(projetId, campagneId) {
      return estTesteur()
          && moi() in ficheCampagne(projetId, campagneId).testeurs;
    }

    function campagneOuverte(projetId, campagneId) {
      return ficheCampagne(projetId, campagneId).statut == 'en-cours';
    }

    // La fin de test. Quand le testeur dit « j'ai terminé », le serveur
    // pose la date dans « termines » et ouvre sept jours de plus dans
    // « fins » : ses résultats se figent, ses remarques restent possibles,
    // puis l'accès s'éteint à la date dite. L'équipe déplace la date
    // (prolonger, clore) ; les règles la relisent à chaque geste.
    function testeurATermine(projetId, campagneId) {
      return moi() in ficheCampagne(projetId, campagneId).get('termines', {});
    }

    function accesTesteurEnCours(projetId, campagneId) {
      return !(moi() in ficheCampagne(projetId, campagneId).get('fins', {}))
          || ficheCampagne(projetId, campagneId).fins[moi()] > request.time;
    }

    // Le vivier, à la racine : un testeur sert sur plusieurs projets sans
    // qu'on lui refasse un compte. Nul ne lit la liste des autres, et c'est
    // volontaire : le nom, l'âge et la fonction d'un testeur ne regardent
    // que l'équipe.
    match /testeurs/{testeurId} {
      // Le vivier entier : l'administrateur, ou qui pilote la recette. Un
      // agent lit les testeurs inscrits sur l'un de ses projets.
      allow read:   if estAdmin()
                    || (estEquipe() && (resource.data.get('projets', []).hasAny(ficheEquipe().get('projets', []))
                                        || ficheEquipe().get('permissions', []).hasAny(['qa.gerer'])))
                    || (estTesteur() && testeurId == moi());
      // Le serveur inscrit, retire, affecte (suiviAdmin). Le testeur, lui,
      // complète SA fiche à sa première connexion, puis tient à jour la
      // liste de ses appareils : son nom, son profil, ce qu'il teste, la
      // date où il a validé. Jamais son adresse, ses projets, son état.
      function profilTesteurBorne(p) {
        return p is map
          && p.keys().hasOnly(['sexe', 'age', 'fonction', 'expertise', 'aisance', 'langue', 'certifie'])
          && texteBorne(p.get('sexe', ''), 20) && texteBorne(p.get('age', ''), 20)
          && texteBorne(p.get('fonction', ''), 120) && texteBorne(p.get('expertise', ''), 200)
          && texteBorne(p.get('aisance', ''), 40) && texteBorne(p.get('langue', ''), 12);
      }
      function appareilsBornes(l) {
        return l is list && l.size() <= 10
          && (l.size() == 0
              || (l[l.size() - 1] is map
                  && l[l.size() - 1].keys().hasOnly(['cle', 'plateforme', 'modele', 'os', 'navigateur', 'ecran', 'reseau', 'agent', 'vu', 'confirme'])
                  && texteBorne(l[l.size() - 1].get('modele', ''), 80)
                  && texteBorne(l[l.size() - 1].get('os', ''), 80)
                  && texteBorne(l[l.size() - 1].get('navigateur', ''), 80)
                  && texteBorne(l[l.size() - 1].get('agent', ''), 300)));
      }
      allow update:  if estTesteur() && testeurId == moi()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nom', 'prenom', 'profil', 'plateformes', 'mobile', 'appareils', 'ficheValidee', 'maj'])
        && texteBorne(request.resource.data.get('nom', ''), 80)
        && texteRequis(request.resource.data.get('prenom', ''), 60)
        && profilTesteurBorne(request.resource.data.get('profil', {}))
        && request.resource.data.get('plateformes', []) is list
        && request.resource.data.get('plateformes', []).size() > 0
        && request.resource.data.get('plateformes', []).hasOnly(['ios', 'android', 'web'])
        && request.resource.data.get('mobile', '') in ['', 'ios', 'android']
        && appareilsBornes(request.resource.data.get('appareils', []))
        && ('ficheValidee' in resource.data
              ? request.resource.data.ficheValidee == resource.data.ficheValidee
              : (!('ficheValidee' in request.resource.data) || request.resource.data.ficheValidee == request.time));
      allow create, delete: if false;   // le serveur seul, via suiviAdmin

      // L'ancien profil public, commun à tous les projets. Il n'est plus
      // écrit (voir projets/{p}/profilsTesteurs) et ne se lit plus que par
      // l'équipe, le temps que la migration l'efface.
      match /public/profil {
        allow read:  if estAdmin();
        allow write: if false;
      }
    }

    match /projets/{projetId} {

      // Le profil des testeurs de CE projet, sans nom ni adresse : âge,
      // fonction, appareils. Recopié par le serveur depuis le vivier, un
      // document par projet où le testeur est inscrit. Le client ne lit que
      // ceux de ses projets, et le document ne dit rien des autres projets
      // du testeur.
      match /profilsTesteurs/{testeurId} {
        allow read:   if accesProjet(projetId);
        allow write:  if false;
      }

      // La bibliothèque. Le client la lit pour savoir ce qui sera vérifié,
      // le testeur pour lire l'énoncé de ce qu'il doit dérouler.
      //
      // Le testeur ne lit QUE les projets où il est inscrit : un titre de
      // scénario nomme un client, une fonctionnalité, un prestataire, et
      // « estTesteur() » seul ouvrait la bibliothèque de tout le hub à
      // quiconque porte la revendication.
      match /scenarios/{scenarioId} {
        allow read:   if accesProjet(projetId) || testeurDuProjet(projetId);
        allow write:  if equipeSurProjet(projetId);
      }

      // Le plan de tests : « ce qui va être testé », une section par
      // document (planTests/{section}), et la présentation de la page
      // (planTests/presentation). Mêmes lecteurs que la bibliothèque : le
      // client du projet, l'équipe du projet, le testeur inscrit. L'équipe
      // seule écrit, sous une forme bornée : l'outil d'import passe par le
      // serveur, le Cockpit par ces règles, et un champ inconnu est refusé.
      match /planTests/{sectionId} {
        function aspectsPlanValides(a) {
          return a is map
              && a.keys().hasOnly(['fonctionnel', 'technique', 'ux', 'securite'])
              && a.get('fonctionnel', []) is list && a.get('technique', []) is list
              && a.get('ux', []) is list && a.get('securite', []) is list
              && a.get('fonctionnel', []).size() <= 400 && a.get('technique', []).size() <= 400
              && a.get('ux', []).size() <= 400 && a.get('securite', []).size() <= 400;
        }
        function sectionPlanValide(d) {
          return d.keys().hasOnly(['id', 'groupe', 'ordre', 'titre', 'resume', 'plateformes', 'aspects', 'maj', 'importeLe', 'editeLe', 'editePar'])
              && d.id == sectionId
              && d.groupe in ['demarrage', 'socle', 'fonctionnalites', 'transverse']
              && d.ordre is int
              && texteRequis(d.titre, 200)
              && texteBorne(d.resume, 2000)
              && d.plateformes is list && d.plateformes.hasOnly(['ios', 'android', 'web'])
              && aspectsPlanValides(d.aspects);
        }
        function presentationPlanValide(d) {
          return d.keys().hasOnly(['genre', 'intro', 'aspects', 'plateformes', 'maj', 'importeLe', 'editeLe', 'editePar'])
              && d.genre == 'presentation'
              && texteBorne(d.get('intro', ''), 3000)
              && texteBorne(d.get('plateformes', ''), 1000)
              && d.get('aspects', {}) is map
              && d.get('aspects', {}).keys().hasOnly(['fonctionnel', 'technique', 'ux', 'securite']);
        }
        allow read:   if accesProjet(projetId) || testeurDuProjet(projetId);
        allow create, update: if equipeSurProjet(projetId)
                      && request.resource.data.maj == request.time
                      && request.resource.data.editePar == moi()
                      && (sectionId == 'presentation'
                          ? presentationPlanValide(request.resource.data)
                          : sectionPlanValide(request.resource.data));
        allow delete: if equipeSurProjet(projetId);
      }

      // Les campagnes. Le testeur lit celles où il figure, et rien d'autre :
      // il ne doit pas déduire du nombre de campagnes ce que fait l'agence
      // pour d'autres clients.
      match /campagnes/{campagneId} {
        allow read:   if accesProjet(projetId)
                      || (estTesteur() && moi() in resource.data.testeurs);
        allow write:  if equipeSurProjet(projetId);

        // Le passage : un scénario, un testeur, une campagne. C'est la seule
        // chose qu'un testeur écrit, et il n'écrit que la sienne.
        //
        // L'identifiant du document porte le testeur (« <uid>__DI-15 »), ce
        // qui rend le cloisonnement vérifiable sans lire le document : une
        // requête sur les passages d'autrui est refusée avant d'être servie.
        match /passages/{passageId} {
          allow read:   if accesProjet(projetId)
                        || (estTesteur() && resource.data.testeur == moi());

          allow create: if testeurDeLaCampagne(projetId, campagneId)
            && campagneOuverte(projetId, campagneId)
            && !testeurATermine(projetId, campagneId)
            && passageId == moi() + '__' + request.resource.data.scenario
            && request.resource.data.testeur == moi()
            && request.resource.data.keys().hasOnly([
                 'scenario', 'testeur', 'plateforme', 'resultat',
                 'commentaire', 'preuves', 'contexte', 'le'
               ])
            && request.resource.data.resultat in ['ok', 'ko', 'na']
            && request.resource.data.plateforme in ['ios', 'android', 'web']
            && texteBorne(request.resource.data.commentaire, 4000)
            && request.resource.data.preuves is list
            && request.resource.data.preuves.size() <= 5
            // Un échec sans preuve n'est pas un rapport, c'est une opinion.
            && (request.resource.data.resultat != 'ko'
                || request.resource.data.preuves.size() > 0);

          // Se corriger, oui. Changer de scénario ou de testeur, non.
          //
          // Les mêmes contrôles de forme qu'à la création, et pour une
          // raison précise : un passage déjà consigné se réécrit avec
          // setDoc, qui est une mise à jour et non une création. Une garde
          // posée sur le seul « create » laisserait la correction passer
          // sans contrôle, ce qui est exactement le trou qu'on cherchait.
          allow update: if testeurDeLaCampagne(projetId, campagneId)
            && campagneOuverte(projetId, campagneId)
            && !testeurATermine(projetId, campagneId)
            && resource.data.testeur == moi()
            && request.resource.data.scenario == resource.data.scenario
            && request.resource.data.testeur == resource.data.testeur
            && request.resource.data.keys().hasOnly([
                 'scenario', 'testeur', 'plateforme', 'resultat',
                 'commentaire', 'preuves', 'contexte', 'le'
               ])
            && request.resource.data.resultat in ['ok', 'ko', 'na']
            && request.resource.data.plateforme in ['ios', 'android', 'web']
            && texteBorne(request.resource.data.commentaire, 4000)
            && request.resource.data.preuves is list
            && request.resource.data.preuves.size() <= 5
            && (request.resource.data.resultat != 'ko'
                || request.resource.data.preuves.size() > 0);

          // Un passage ne s'efface pas : c'est la mémoire de la campagne.
          allow delete: if false;

          // Le rattachement à une anomalie est un geste de tri, et c'est le
          // SEUL champ que l'équipe touche sur un passage. Un « allow
          // update: if estEquipe() » nu annulerait tout ce qui précède :
          // Firestore fait l'union des règles, donc la plus permissive
          // gagne, et le gel de la campagne close tomberait avec elle.
          //
          // Le tri se fait souvent après la clôture : on l'autorise donc
          // sur une campagne close, mais sur ce champ et rien d'autre.
          allow update: if equipeSurProjet(projetId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anomalie']);
        }

        // L'appréciation : ce que le testeur pense de l'application. Une par
        // testeur et par campagne, et l'identifiant est son propre uid.
        match /appreciations/{testeurId} {
          allow read:   if accesProjet(projetId)
                        || (estTesteur() && testeurId == moi());

          // Bornée, comme tout ce qu'un testeur écrit : sans plafond, un
          // champ libre est une porte ouverte sur le stockage du projet.
          //
          // « termine » est la date où il a dit « j'ai terminé » : celle du
          // serveur, posée une fois, jamais reprise. « remarques » : ce qu'il
          // ajoute après coup, pendant les jours d'accès qui lui restent ;
          // une liste qui ne fait que grandir, vingt au plus, chacune bornée.
          // « noteTest » : ce que le testeur pense du TEST lui-même (clair,
          // faisable), une note sur cinq et quelques mots, posés en disant
          // « j'ai terminé ».
          function appreciationBornee(d) {
            return d.size() <= 60
              && texteBorne(d.get('libre', ''), 8000)
              && (!('noteTest' in d)
                  || (d.noteTest is map
                      && d.noteTest.keys().hasOnly(['note', 'commentaire', 'le'])
                      && d.noteTest.note is int && d.noteTest.note >= 1 && d.noteTest.note <= 5
                      && texteBorne(d.noteTest.get('commentaire', ''), 2000)))
              && (!('remarques' in d)
                  || (d.remarques is list && d.remarques.size() <= 20
                      && (d.remarques.size() == 0
                          || (d.remarques[d.remarques.size() - 1] is map
                              && texteRequis(d.remarques[d.remarques.size() - 1].get('texte', ''), 4000)))));
          }

          allow create: if estTesteur()
            && testeurId == moi()
            && testeurDeLaCampagne(projetId, campagneId)
            && campagneOuverte(projetId, campagneId)
            && accesTesteurEnCours(projetId, campagneId)
            && appreciationBornee(request.resource.data)
            && (!('termine' in request.resource.data) || request.resource.data.termine == request.time);

          allow update: if estTesteur()
            && testeurId == moi()
            && testeurDeLaCampagne(projetId, campagneId)
            && campagneOuverte(projetId, campagneId)
            && accesTesteurEnCours(projetId, campagneId)
            && appreciationBornee(request.resource.data)
            && request.resource.data.get('remarques', []).size() >= resource.data.get('remarques', []).size()
            && ('termine' in resource.data
                  ? request.resource.data.termine == resource.data.termine
                  : (!('termine' in request.resource.data) || request.resource.data.termine == request.time));

          // Une appréciation ne s'efface pas plus qu'un passage : c'est la
          // mémoire de la campagne, et se raviser après coup la falsifie.
          allow delete: if false;
        }
      }

      // Les anomalies : le regroupement des échecs. Trois testeurs qui
      // tombent sur le même scénario font une anomalie, pas trois.
      // Le testeur ne les voit pas : il rapporte, il ne juge pas.
      match /anomalies/{anomalieId} {
        allow read:   if accesProjet(projetId);
        allow write:  if equipeSurProjet(projetId);
      }

      // Les parcours automatisés. Le client les lit : savoir que quarante
      // -huit parcours sont rejoués à chaque version fait partie de ce
      // qu'il paie. Le testeur, lui, n'a rien à y faire : ce n'est pas son
      // travail, et lui montrer ce que la machine couvre l'inciterait à
      // survoler les mêmes chemins.
      match /parcours/{parcoursId} {
        allow read:   if accesProjet(projetId);
        allow write:  if equipeSurProjet(projetId);
      }

      // Les familles de règles métier. Mêmes droits que les parcours, et
      // pour la même raison : le client paie une base de tests, il a le
      // droit de voir sa profondeur. Le testeur n'y a rien à faire.
      // Les suggestions d'amélioration de Capmedia. L'équipe écrit tout ;
      // le client membre ne lit que les publiées, et ne touche qu'à sa
      // réponse (intéressé ou non, avec l'état qui va avec) et à sa marque
      // « vue » : jamais le prix, le texte ni la publication.
      match /suggestions/{suggestionId} {
        function suggestionValide(d) {
          return d.keys().hasOnly(['famille', 'titre', 'resume', 'texte', 'benefice', 'plateformes', 'duree', 'prix', 'tva', 'devis', 'visuel',
                                   'statut', 'publication', 'publieLe', 'ordre', 'aLaUne', 'reponse', 'jalon', 'vues', 'cree', 'maj'])
              && d.famille in ['developpement', 'conseil']
              && texteRequis(d.titre, 160)
              && texteBorne(d.resume, 400)
              && texteBorne(d.texte, 8000)
              && texteBorne(d.benefice, 400)
              && d.plateformes is list && d.plateformes.size() <= 8
              && texteBorne(d.duree, 80)
              && (d.prix == null || (d.prix is number && d.prix >= 0 && d.prix <= 10000000))
              && d.tva is number && d.tva >= 0 && d.tva <= 100
              && texteBorne(d.devis, 80)
              && d.statut in ['proposee', 'a-l-etude', 'acceptee', 'livree', 'refusee', 'retiree']
              && d.publication in ['brouillon', 'publiee']
              && d.ordre is number
              && d.aLaUne is bool
              && texteBorne(d.jalon, 80)
              && d.vues is map;
        }
        allow read: if equipeSurProjet(projetId)
          || (membreDuProjet(projetId) && resource.data.publication == 'publiee');
        allow create: if equipeSurProjet(projetId) && suggestionValide(request.resource.data);
        allow delete: if equipeSurProjet(projetId);
        // L'équipe modifie tout, dans les bornes.
        allow update: if equipeSurProjet(projetId) && suggestionValide(request.resource.data);
        // Le client marque qu'il a vu : sa seule clé, et rien d'autre ne bouge.
        allow update: if membreDuProjet(projetId)
          && resource.data.publication == 'publiee'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vues'])
          && request.resource.data.vues.diff(resource.data.vues).affectedKeys().hasOnly([moi()]);
        // Le client répond : intéressé (à l'étude) ou non (déclinée), ou
        // revient sur son choix (proposée). Rien d'autre ne change.
        allow update: if membreDuProjet(projetId)
          && resource.data.publication == 'publiee'
          && resource.data.statut in ['proposee', 'a-l-etude', 'refusee']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'reponse', 'maj'])
          && request.resource.data.maj == request.time
          && (
            (request.resource.data.statut == 'proposee' && request.resource.data.reponse == null)
            || (request.resource.data.statut in ['a-l-etude', 'refusee']
                && request.resource.data.reponse is map
                && request.resource.data.reponse.keys().hasOnly(['par', 'nom', 'choix', 'raison', 'demande', 'le'])
                && request.resource.data.reponse.par == moi()
                && texteBorne(request.resource.data.reponse.nom, 120)
                && request.resource.data.reponse.choix == (request.resource.data.statut == 'a-l-etude' ? 'interesse' : 'pas-interesse')
                && texteBorne(request.resource.data.reponse.raison, 1000)
                && texteBorne(request.resource.data.reponse.demande, 80)
                && request.resource.data.reponse.le == request.time)
          );
      }

      match /regles/{regleId} {
        allow read:   if accesProjet(projetId);
        allow write:  if equipeSurProjet(projetId);
      }

      // Les exécutions des robots : branche, commit, machine, messages
      // d'erreur. Le client lit le verdict de chaque parcours, en direct,
      // sur le parcours lui-même ; le détail de la machine ne regarde que
      // l'équipe. Seule la porte des robots écrit ici.
      match /executions/{executionId} {
        allow read:   if equipeSurProjet(projetId);
        allow write:  if false;
        match /resultats/{ref} {
          allow read:   if equipeSurProjet(projetId);
          allow write:  if false;
        }
      }
    }

    // La note d'un projet à faire : l'idée telle qu'on l'a en tête. Elle
    // vit hors du projet, parce qu'un client membre lit toute la fiche de
    // son projet : une note posée là lui serait lisible, même sans écran
    // pour la montrer. Ici, seule l'équipe lit et écrit.
    match /idees/{projetId} {
      allow read:   if estAdmin();
      allow create, update: if estAdmin()
        && request.resource.data.keys().hasOnly(['texte', 'par', 'maj'])
        && texteBorne(request.resource.data.texte, 60000);
      allow delete: if estAdmin();
    }

    // Les jetons des robots de tests. Seule leur empreinte est ici : le
    // jeton lui-même n'est montré qu'une fois, à sa création.
    match /robots/{jetonId} {
      allow read:   if estAdmin();
      allow write:  if false;
    }

    // La présence des testeurs : qui est là, depuis quand, sur quel
    // scénario. L'équipe seule la lit ; le client ne voit que des
    // résultats, et un testeur ne voit jamais les autres.
    //
    // Les dates viennent du serveur (« request.time »), jamais du
    // navigateur : une durée de session qu'on pourrait antidater ne
    // mesurerait rien. Le début ne bouge plus une fois posé.
    function presenceBornee(d) {
      return texteBorne(d.get('campagne', ''), 40)
          && texteBorne(d.get('projet', ''), 40)
          && d.get('plateforme', '') in ['', 'ios', 'android', 'web']
          && texteBorne(d.get('scenario', ''), 24)
          && texteBorne(d.get('session', ''), 40);
    }

    match /presences/{uid} {
      allow read: if estEquipe();
      allow create, update: if estTesteur() && uid == moi()
        && request.resource.data.keys().hasOnly([
             'campagne', 'projet', 'plateforme', 'scenario', 'vue',
             'session', 'debut', 'vu', 'enLigne'
           ])
        && presenceBornee(request.resource.data)
        && request.resource.data.get('vue', '') in ['', 'grille', 'liste']
        && request.resource.data.enLigne is bool
        && request.resource.data.vu == request.time
        && (request.resource.data.debut == request.time
            || (resource != null && request.resource.data.debut == resource.data.debut));
      allow delete: if false;

      match /sessions/{sessionId} {
        // Le testeur relit SES sessions, et seulement elles : c'est son
        // chronomètre (le temps donné à la campagne). La présence en cours,
        // elle, reste à l'équipe.
        allow read: if estEquipe() || (estTesteur() && uid == moi());
        allow create: if estTesteur() && uid == moi()
          && request.resource.data.keys().hasOnly(['debut', 'vu', 'campagne', 'projet', 'plateforme', 'agent'])
          && presenceBornee(request.resource.data)
          && texteBorne(request.resource.data.get('agent', ''), 300)
          && request.resource.data.debut == request.time
          && request.resource.data.vu == request.time;
        allow update: if estTesteur() && uid == moi()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vu', 'plateforme'])
          && request.resource.data.get('plateforme', '') in ['', 'ios', 'android', 'web']
          && request.resource.data.vu == request.time;
        allow delete: if false;
      }
    }

    // La console de tests regarde tous les projets d'un coup. Ces trois
    // lectures en groupe ne sont ouvertes qu'à l'équipe : un client n'a
    // aucune raison de voir ce qui se teste ailleurs, et un testeur encore
    // moins. Chacun passe par la collection de son projet, qui porte ses
    // propres contrôles.
    match /{chemin=**}/scenarios/{scenarioId} {
      allow read: if estAdmin();
    }

    match /{chemin=**}/campagnes/{campagneId} {
      allow read: if estAdmin();
    }

    match /{chemin=**}/anomalies/{anomalieId} {
      allow read: if estAdmin();
    }

    match /{chemin=**}/parcours/{parcoursId} {
      allow read: if estAdmin();
    }

    match /{chemin=**}/regles/{regleId} {
      allow read: if estAdmin();
    }

    // Les anciens profils publics, lus en groupe : l'équipe seule.
    match /{chemin=**}/public/{docId} {
      allow read: if estAdmin();
    }

    // Les profils des testeurs d'un projet, lus d'un coup par l'équipe.
    match /{chemin=**}/profilsTesteurs/{testeurId} {
      allow read: if estAdmin();
    }

    // La porte d'entrée. Ces trois collections portent l'empreinte des
    // codes en cours, les compteurs de tentatives et les jetons
    // d'invitation : rien de tout cela ne se lit ni ne s'écrit depuis un
    // navigateur, même connecté, même membre de l'équipe. Seul le serveur
    // y touche, et c'est ce qui rend les garde-fous infranchissables.
    match /connexions/{cle}      { allow read, write: if false; }
    match /connexionsIp/{cle}    { allow read, write: if false; }
    match /invitations/{jeton}   { allow read, write: if false; }
    // Les clés d'accès et leurs défis : le serveur seul (cles.js).
    match /cles/{cleId}          { allow read, write: if false; }
    match /defis/{defiId}        { allow read, write: if false; }

    // ================================================================
    // FORMULAIRES PUBLICS DU SITE (déjà en service sur ce projet)
    //
    // Le visiteur dépose sa demande sans compte. La lecture est réservée à
    // l'équipe : des comptes clients existent sur ce projet et ne doivent
    // pas voir le fichier des prospects.
    // ================================================================

    match /project-requests/{demandeId} {
      allow create: if true;
      allow read, update, delete: if estAdmin();
    }

    match /contact-messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if estAdmin();
    }

    match /flexy-requests/{demandeId} {
      allow create: if true;
      allow read, update, delete: if estAdmin();
    }

    // --- Tout le reste est fermé ---------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
