rules_version = '2';

/*
  CAPMEDIA CLIENT HUB · Règles Storage
  Projet Firebase : capmedia-1f90d. Contrat : docs/suivi.md

  La liste des membres d'un projet vit dans Firestore ; les règles de
  stockage ne peuvent pas la lire. On s'appuie donc sur le jeton : le
  client reçoit une revendication « projets » à son invitation, posée par
  l'Admin SDK. L'équipe reçoit « equipe: true ».

  Organisation :
    projets/{projet}/tickets/{ticket}/...      pièces des demandes
    projets/{projet}/documents/{dossier}/...   devis, factures, fichiers, validations, dépôts client
    projets/{projet}/messages/...              pièces de la conversation
    preprojets/{uid}/...                       pièces d'une demande de nouveau projet
*/

service firebase.storage {
  match /b/{bucket}/o {

    function estEquipe() {
      return request.auth != null && request.auth.token.equipe == true;
    }

    function surSonProjet(projetId) {
      return request.auth != null
          && request.auth.token.projets != null
          && projetId in request.auth.token.projets;
    }

    function fichierAccepte() {
      return (request.resource.size < 10 * 1024 * 1024
              && (request.resource.contentType.matches('image/.*')
                  || request.resource.contentType == 'application/pdf'
                  || request.resource.contentType == 'text/plain'
                  || request.resource.contentType == 'application/zip'
                  || request.resource.contentType.matches('application/(msword|vnd\\.openxmlformats-officedocument\\..*)')))
          || (request.resource.size < 100 * 1024 * 1024
              && request.resource.contentType.matches('video/(mp4|quicktime|webm)'));
    }

    // Les pièces jointes des demandes : l'équipe et le client du projet.
    match /projets/{projetId}/tickets/{ticketId}/{fichier=**} {
      allow read:   if estEquipe() || surSonProjet(projetId);
      allow write:  if (estEquipe() || surSonProjet(projetId)) && fichierAccepte();
      allow delete: if estEquipe();
    }

    // Les dépôts du client (captures, logos, assets) : il écrit, tout le monde du projet lit.
    match /projets/{projetId}/documents/client/{fichier=**} {
      allow read:   if estEquipe() || surSonProjet(projetId);
      allow write:  if (estEquipe() || surSonProjet(projetId)) && fichierAccepte();
      allow delete: if estEquipe();
    }

    // Devis, factures, fichiers, validations : déposés par l'équipe, lus par le client.
    match /projets/{projetId}/documents/{dossier}/{fichier=**} {
      allow read:   if estEquipe() || surSonProjet(projetId);
      allow write:  if estEquipe() && fichierAccepte();
      allow delete: if estEquipe();
    }

    // La conversation du projet.
    match /projets/{projetId}/messages/{fichier=**} {
      allow read:   if estEquipe() || surSonProjet(projetId);
      allow write:  if (estEquipe() || surSonProjet(projetId)) && fichierAccepte();
      allow delete: if estEquipe();
    }

    // Les preuves d'un testeur : une capture, une vidéo courte, jointe à un
    // passage. Le testeur écrit dans SON dossier et nulle part ailleurs ;
    // l'équipe et le client du projet les lisent, puisque la fiche d'une
    // anomalie les montre.
    //
    // Sans cette règle, le dossier tombait dans le « refus général » de la
    // fin : l'envoi échouait, et comme les règles Firestore exigent une
    // preuve pour un KO, aucun échec ne pouvait être consigné.
    match /campagnes/{projetId}/{campagneId}/{uid}/{fichier=**} {
      allow read:   if estEquipe() || surSonProjet(projetId);
      allow write:  if request.auth != null
                    && request.auth.uid == uid
                    && request.auth.token.testeur == true
                    && fichierAccepte();
      allow delete: if estEquipe();
    }

    // Une demande de nouveau projet : le demandeur dépose dans son dossier, l'équipe lit.
    match /preprojets/{uid}/{fichier=**} {
      allow read:   if estEquipe() || (request.auth != null && request.auth.uid == uid);
      allow write:  if (estEquipe() || (request.auth != null && request.auth.uid == uid)) && fichierAccepte();
      allow delete: if estEquipe();
    }

    match /{tout=**} {
      allow read, write: if false;
    }
  }
}
