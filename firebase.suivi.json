{
  "firestore": {
    "rules": "suivi/firestore.rules",
    "indexes": "suivi/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "fonctions-suivi",
      "codebase": "suivi",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "*.local",
        "outils"
      ]
    }
  ],
  "storage": {
    "rules": "suivi/storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
