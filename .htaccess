# Capmedia Academy : la page d'accueil est index.html (avant l'index.php
# parqué d'Hostinger), pas de listage de dossiers, tout en HTTPS sur l'apex.
DirectoryIndex index.html index.php
Options -Indexes

RewriteEngine On

# HTTP vers HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://academy.capmedia.app%{REQUEST_URI} [R=301,L]

# www vers l'apex
RewriteCond %{HTTP_HOST} ^www\.capmedia\.app$ [NC]
RewriteRule ^ https://academy.capmedia.app%{REQUEST_URI} [R=301,L]

# --- Cache -----------------------------------------------------------------
# Par défaut, Hostinger garde le JS et le CSS SEPT JOURS chez le visiteur :
# une correction mettait une semaine à arriver, et une page pouvait tourner
# avec un ancien script (connexion cassée, anciens prix). On révalide donc à
# chaque visite : le serveur répond 304 si rien n'a changé, le coût est nul.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
    Header unset Pragma
  </FilesMatch>

  # Les images et polices peuvent rester en cache : elles changent de nom
  # quand elles changent de contenu.
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>
