rules_version = '2';

/*
  CAPMEDIA ACADEMY · Règles de sécurité Firestore (modèle Parcours)

  Principe central inchangé : le contenu vit ici, pas dans le dépôt
  public. La lecture exige un compte connecté À EMAIL VÉRIFIÉ.

  Le modèle d'accès :
   · Formations GRATUITES (github, prompting, claude-code) : lisibles par
     tout compte connecté vérifié. C'est le produit d'appel : le compte
     (donc l'e-mail) est le prix d'entrée.
   · Formations du PARCOURS (firebase, mobile, design-app, aso,
     seo-contenu) : réservées au pack. acheteurs/{email}.pack = 'parcours'
     (les anciens 'basic'/'avance' de la période de test restent honorés).
   · Formations SÉPARÉES (site-web-ia, automatiser-ia, stripe,
     micro-saas) : achat à l'unité. acheteurs/{email}.achats[slug].
   · acheteurs/ n'est écrit QUE par le webhook Stripe et l'admin.
   · profils/{uid} : le nom du membre, écrit par lui-même.

  Déployer :  firebase deploy --only firestore:rules
*/

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fonctions utilitaires ----------------------------------------
    function connecte() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true;
    }

    function monEmail() {
      return request.auth.token.email.lower();
    }

    function maFiche() {
      return get(/databases/$(database)/documents/acheteurs/$(monEmail())).data;
    }

    function aAchete() {
      return connecte()
          && exists(/databases/$(database)/documents/acheteurs/$(monEmail()));
    }

    // Le fil conducteur, côté sécurité.
    function estGratuite(slug) {
      // 'sos' : la bible des erreurs, offerte à tous les membres connectés.
      return slug in ['github', 'prompting', 'claude-code', 'sos'];
    }
    function estParcours(slug) {
      return slug in ['firebase', 'mobile', 'design-app', 'aso', 'seo-contenu'];
    }

    // Accès payant à une formation : pack pour le parcours, achat à
    // l'unité pour les séparées. Les anciens champs (pack basic/avance,
    // « offre » mobile) restent honorés par prudence.
    function accesFormation(slug) {
      let fiche = maFiche();
      return estParcours(slug)
        ? (fiche.pack != null
            || (fiche.achats != null && slug in fiche.achats)
            || (slug == 'mobile' && fiche.offre != null))
        : ((fiche.achats != null && slug in fiche.achats)
            || fiche.pack == 'basic'
            || fiche.pack == 'avance');
    }

    // --- Les acheteurs ------------------------------------------------
    // Écrits UNIQUEMENT par le webhook Stripe et l'admin (Admin SDK).
    match /acheteurs/{email} {
      allow read:  if connecte() && monEmail() == email;
      allow write: if false;
    }

    // --- Le profil du membre (le nom, saisi par lui-même) ---------------
    match /profils/{uid} {
      allow read: if connecte() && request.auth.uid == uid;
      allow create, update: if connecte()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nom', 'email', 'maj'])
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 0
        && request.resource.data.nom.size() <= 80;
      allow delete: if false;
    }

    // --- Le contenu des formations --------------------------------------
    // Une seule offre par formation : plus de découpage essentiel/complet,
    // les anciens acheteurs Essentiel y gagnent les bonus.
    match /formations/{slug}/lecons/{leconId} {
      allow read:  if connecte() && (estGratuite(slug) || (aAchete() && accesFormation(slug)));
      allow write: if false;   // seed Admin uniquement
    }

    match /formations/{slug}/contenus/{leconId} {
      allow read:  if connecte() && (estGratuite(slug) || (aAchete() && accesFormation(slug)));
      allow write: if false;
    }

    // --- Le contenu anglais : mêmes droits que le français ---------------
    match /formations-en/{slug}/lecons/{leconId} {
      allow read:  if connecte() && (estGratuite(slug) || (aAchete() && accesFormation(slug)));
      allow write: if false;
    }
    match /formations-en/{slug}/contenus/{leconId} {
      allow read:  if connecte() && (estGratuite(slug) || (aAchete() && accesFormation(slug)));
      allow write: if false;
    }

    // --- La progression -----------------------------------------------
    // Ouverte à tout membre connecté : les gratuites se suivent aussi.
    match /progression/{uid} {
      allow read, write: if connecte() && request.auth.uid == uid;
    }

    // --- Les avis --------------------------------------------------------
    // Tout membre peut écrire un avis (gratuit compris) : rien ne se
    // publie sans modération (publie=false imposé à l'écriture).
    match /avis/{uid} {
      allow read: if resource.data.publie == true
                  || (connecte() && request.auth.uid == uid);
      allow create, update: if connecte()
        && request.auth.uid == uid
        && request.resource.data.publie == false
        && request.resource.data.note is int
        && request.resource.data.note >= 1
        && request.resource.data.note <= 5
        && request.resource.data.texte is string
        && request.resource.data.texte.size() > 0
        && request.resource.data.texte.size() <= 1200
        && request.resource.data.prenom is string
        && request.resource.data.prenom.size() > 0
        && request.resource.data.prenom.size() <= 60;
    }

    // --- Le support : un message à la fois -------------------------------
    // Ouvert à tout membre connecté, gratuits compris.
    match /conversations/{uid} {
      allow read: if connecte() && request.auth.uid == uid;

      allow create: if connecte()
        && request.auth.uid == uid
        && request.resource.data.tour == 'nadir'
        && request.resource.data.messages.size() == 1
        && request.resource.data.dernier.de == 'membre'
        && request.resource.data.dernier.texte is string
        && request.resource.data.dernier.texte.size() > 0
        && request.resource.data.dernier.texte.size() <= 2000;

      allow update: if connecte()
        && request.auth.uid == uid
        && resource.data.tour == 'membre'
        && request.resource.data.tour == 'nadir'
        && request.resource.data.messages.size() == resource.data.messages.size() + 1
        && request.resource.data.dernier.de == 'membre'
        && request.resource.data.dernier.texte is string
        && request.resource.data.dernier.texte.size() > 0
        && request.resource.data.dernier.texte.size() <= 2000;
    }

    // --- La liste d'attente du lancement ---------------------------------
    match /attente/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'date', 'source', 'langue'])
        && request.resource.data.email is string
        && request.resource.data.email == email
        && email.matches('.+@.+[.].+')
        && email.size() <= 120
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 40;
      allow read, update, delete: if false;
    }

    // --- La galerie des apps membres -------------------------------------
    // Chaque membre soumet son application (statut « attente ») ; seule la
    // modération (console, Admin SDK) publie. Les apps publiées sont
    // PUBLIQUES : lisibles sans compte, c'est la vitrine du site.
    match /apps-membres/{appId} {
      allow read: if resource.data.statut == 'publiee'
                  || (connecte() && resource.data.uid == request.auth.uid);
      allow create: if connecte()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == monEmail()
        && request.resource.data.statut == 'attente'
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nom', 'pitch', 'description', 'lienApple', 'lienGoogle', 'lienWeb', 'captures', 'date', 'statut'])
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 0
        && request.resource.data.nom.size() <= 60
        && request.resource.data.pitch is string
        && request.resource.data.pitch.size() <= 140
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.captures is list
        && request.resource.data.captures.size() <= 6;
      allow update: if connecte()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.statut == resource.data.statut
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nom', 'pitch', 'description', 'lienApple', 'lienGoogle', 'lienWeb', 'captures', 'date', 'statut'])
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 0
        && request.resource.data.nom.size() <= 60
        && request.resource.data.pitch.size() <= 140
        && request.resource.data.description.size() <= 2000
        && request.resource.data.captures.size() <= 6;
      allow delete: if connecte() && resource.data.uid == request.auth.uid;

      // Un j'aime par membre connecté, sur les apps publiées uniquement.
      match /jaimes/{uid} {
        allow read: if true;
        allow create: if connecte()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/apps-membres/$(appId)).data.statut == 'publiee';
        allow delete: if connecte() && request.auth.uid == uid;
        allow update: if false;
      }

      // Un avis par membre connecté, public, sur les apps publiées.
      match /avis/{uid} {
        allow read: if true;
        allow create, update: if connecte()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/apps-membres/$(appId)).data.statut == 'publiee'
          && request.resource.data.keys().hasOnly(['nom', 'texte', 'note', 'date'])
          && request.resource.data.nom is string
          && request.resource.data.nom.size() > 0
          && request.resource.data.nom.size() <= 60
          && request.resource.data.texte is string
          && request.resource.data.texte.size() > 0
          && request.resource.data.texte.size() <= 600
          && request.resource.data.note is int
          && request.resource.data.note >= 1
          && request.resource.data.note <= 5;
        allow delete: if connecte() && request.auth.uid == uid;
      }
    }

    // --- Les demandes de devis (site agence capmedia.app) ----------------
    // Création anonyme, jamais de lecture publique : seules la console
    // (Admin SDK) les lit. Le statut de départ est imposé.
    match /devis/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'message', 'nom', 'email', 'telephone', 'entreprise', 'date', 'langue', 'statut'])
        && request.resource.data.statut == 'nouveau'
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 4000
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 0
        && request.resource.data.nom.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.email.size() <= 120
        && request.resource.data.telephone is string
        && request.resource.data.telephone.size() <= 30
        && request.resource.data.entreprise is string
        && request.resource.data.entreprise.size() <= 80;
      allow read, update, delete: if false;
    }

    // ================================================================
    // ESPACE DE SUIVI CLIENT (capmedia.app/suivi)
    // Contrat : docs/suivi.md
    //
    // Deux publics, une seule porte. L'équipe voit tout ; le client voit
    // son projet et rien d'autre. Toute écriture qui engage (numéro,
    // statut d'une facture, journal d'audit) est refusée au navigateur et
    // passe par l'Admin SDK ou une fonction.
    // ================================================================

    // Membre de l'équipe : le document existe, donc l'accès est total.
    // Il n'est créé que par l'Admin SDK, jamais depuis le navigateur.
    function estEquipe() {
      return connecte()
          && exists(/databases/$(database)/documents/equipe/$(request.auth.uid));
    }

    function ficheProjet(projetId) {
      return get(/databases/$(database)/documents/projets/$(projetId)).data;
    }

    // Client autorisé sur ce projet.
    function membreDuProjet(projetId) {
      return connecte() && request.auth.uid in ficheProjet(projetId).membres;
    }

    function ficheTicket(ticketId) {
      return get(/databases/$(database)/documents/tickets/$(ticketId)).data;
    }

    function accesTicket(ticketId) {
      return estEquipe() || membreDuProjet(ficheTicket(ticketId).projet);
    }

    // --- L'équipe ---------------------------------------------------
    match /equipe/{uid} {
      // Chacun lit sa propre fiche : c'est ce qui décide du rôle à l'écran.
      allow read:  if connecte() && request.auth.uid == uid;
      allow write: if false;
    }

    // --- Les projets ------------------------------------------------
    match /projets/{projetId} {
      allow read:  if estEquipe()
                   || (connecte() && request.auth.uid in resource.data.membres);
      allow write: if false;
    }

    // --- Les tickets ------------------------------------------------
    match /tickets/{ticketId} {

      function valeursConnues() {
        return request.resource.data.type in ['bug', 'demande', 'question']
            && request.resource.data.urgence in ['bloquant', 'critique', 'important', 'mineur']
            && request.resource.data.plateforme in ['ios', 'android', 'web', ''];
      }

      function taillesTenues() {
        return request.resource.data.titre is string
            && request.resource.data.titre.size() > 0
            && request.resource.data.titre.size() <= 120
            && request.resource.data.description is string
            && request.resource.data.description.size() > 0
            && request.resource.data.description.size() <= 6000
            && request.resource.data.etapes is string
            && request.resource.data.etapes.size() <= 4000
            && request.resource.data.attendu is string
            && request.resource.data.attendu.size() <= 2000
            && request.resource.data.obtenu is string
            && request.resource.data.obtenu.size() <= 2000
            && request.resource.data.version is string
            && request.resource.data.version.size() <= 40
            && request.resource.data.pieces is list
            && request.resource.data.pieces.size() <= 10;
      }

      // Création : le numéro est posé par la fonction, jamais par le client.
      // L'auteur est forcément celui qui écrit.
      function creationValide() {
        return request.resource.data.keys().hasOnly([
                 'numero', 'projet', 'titre', 'description', 'type', 'urgence',
                 'statut', 'plateforme', 'version', 'etapes', 'attendu', 'obtenu',
                 'assigne', 'auteur', 'pieces', 'archive', 'cree', 'maj', 'resolu', 'lu'
               ])
            && request.resource.data.numero == null
            && request.resource.data.statut == 'nouveau'
            && request.resource.data.archive == false
            && request.resource.data.assigne == null
            && request.resource.data.resolu == null
            && request.resource.data.auteur.uid == request.auth.uid
            && request.resource.data.auteur.email == monEmail()
            && request.resource.data.projet is string
            && valeursConnues()
            && taillesTenues();
      }

      // L'équipe pilote : statut, urgence, assignation, archive, lecture.
      // Le numéro, le projet, l'auteur et la date de création sont figés.
      function majEquipe() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['statut', 'urgence', 'assigne', 'archive', 'maj',
                           'resolu', 'lu', 'titre', 'type', 'plateforme', 'pieces'])
            && request.resource.data.statut in ['nouveau', 'en-cours', 'en-attente-client',
                                                'a-valider', 'resolu', 'ferme', 'refuse']
            && request.resource.data.urgence in ['bloquant', 'critique', 'important', 'mineur'];
      }

      // Le client ne fait que trois choses : marquer comme lu, valider une
      // correction, ou rouvrir dans les sept jours. Rien d'autre ne bouge.
      function clientMarqueLu() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lu']);
      }

      function clientValide() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['statut', 'maj', 'resolu', 'lu'])
            && resource.data.statut == 'a-valider'
            && request.resource.data.statut == 'resolu';
      }

      function clientRouvre() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['statut', 'maj', 'lu'])
            && resource.data.statut == 'resolu'
            && request.resource.data.statut == 'en-cours'
            && resource.data.resolu != null
            && request.time < resource.data.resolu + duration.value(7, 'd');
      }

      function ajoutPieces() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pieces', 'maj'])
            && request.resource.data.pieces is list
            && request.resource.data.pieces.size() <= 10;
      }

      allow read: if estEquipe() || membreDuProjet(resource.data.projet);

      allow create: if creationValide()
                    && (estEquipe() || membreDuProjet(request.resource.data.projet));

      allow update: if estEquipe()
                      ? majEquipe()
                      : (membreDuProjet(resource.data.projet)
                         && (clientMarqueLu() || clientValide() || clientRouvre() || ajoutPieces()));

      allow delete: if false;

      // --- Les messages du ticket ---------------------------------
      // Une note interne est invisible au client : les règles la refusent,
      // le client interroge la sous-collection avec interne == false.
      match /messages/{messageId} {
        allow read: if estEquipe()
                    || (membreDuProjet(ficheTicket(ticketId).projet)
                        && resource.data.interne == false);

        allow create: if accesTicket(ticketId)
          && request.resource.data.keys().hasOnly(['de', 'texte', 'pieces', 'interne', 'date'])
          && request.resource.data.de.uid == request.auth.uid
          && request.resource.data.de.cote == (estEquipe() ? 'equipe' : 'client')
          && request.resource.data.interne == (estEquipe() ? request.resource.data.interne : false)
          && request.resource.data.texte is string
          && request.resource.data.texte.size() > 0
          && request.resource.data.texte.size() <= 6000
          && request.resource.data.pieces is list
          && request.resource.data.pieces.size() <= 10;

        allow update, delete: if false;
      }

      // --- Le journal d'audit --------------------------------------
      // Lecture seule, écrit par les fonctions. C'est ce qui rend
      // l'historique digne de confiance.
      match /evenements/{evenementId} {
        allow read:  if accesTicket(ticketId);
        allow write: if false;
      }
    }

    // --- Les devis et les factures ----------------------------------
    // Déposés par l'équipe. Le client lit, et répond à un devis. Il ne
    // touche jamais un montant, un numéro ni une facture.
    match /documents/{documentId} {
      allow read: if estEquipe() || membreDuProjet(resource.data.projet);

      allow update: if !estEquipe()
        && membreDuProjet(resource.data.projet)
        && resource.data.type == 'devis'
        && resource.data.statut == 'envoye'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'reponse'])
        && request.resource.data.statut in ['accepte', 'refuse']
        && request.resource.data.reponse.par == request.auth.uid;

      allow create, delete: if false;
    }

    // --- La file des e-mails ----------------------------------------
    // Personne n'y touche depuis le navigateur.
    match /envois/{envoiId} {
      allow read, write: if false;
    }

    // --- Tout le reste est fermé ---------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
