rules_version = '2';

/*
  CAPMEDIA ACADEMY · Règles de sécurité Firestore (multi-formations)

  Principe inchangé et central : le contenu vit ici, pas dans le dépôt
  public. La lecture exige un compte connecté À EMAIL VÉRIFIÉ et un
  document acheteurs/{email} écrit uniquement par le webhook Stripe.

  Nouveautés multi-formations :
   · acheteurs/{email}.achats = { <slug>: 'essentiel'|'complet', ... }
   · acheteurs/{email}.pack   = null | 'basic' | 'avance'
     Le pack ouvre toutes les formations ('basic' = essentiel partout,
     'avance' = complet partout).
   · formations/{slug}/lecons + formations/{slug}/contenus

  Déployer :  firebase deploy --only firestore:rules
*/

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fonctions utilitaires ----------------------------------------
    function connecte() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true;
    }

    function monEmail() {
      return request.auth.token.email.lower();
    }

    function maFiche() {
      return get(/databases/$(database)/documents/acheteurs/$(monEmail())).data;
    }

    function aAchete() {
      return connecte()
          && exists(/databases/$(database)/documents/acheteurs/$(monEmail()));
    }

    // Accès à une formation : achat direct, ou pack, ou l'ancien champ
    // « offre » (comptes d'avant la migration, par prudence).
    function accesFormation(slug) {
      let fiche = maFiche();
      return (fiche.achats != null && slug in fiche.achats)
          || (fiche.pack != null)
          || (slug == 'mobile' && fiche.offre != null);
    }

    // Niveau « complet » sur une formation
    function accesComplet(slug) {
      let fiche = maFiche();
      return (fiche.achats != null && slug in fiche.achats && fiche.achats[slug] == 'complet')
          || fiche.pack == 'avance'
          || (slug == 'mobile' && fiche.offre == 'complet');
    }

    // --- Les acheteurs ------------------------------------------------
    // Écrits UNIQUEMENT par le webhook Stripe et l'admin (Admin SDK).
    match /acheteurs/{email} {
      allow read:  if connecte() && monEmail() == email;
      allow write: if false;
    }

    // --- Le contenu des formations --------------------------------------
    match /formations/{slug}/lecons/{leconId} {
      allow read:  if aAchete() && accesFormation(slug);
      allow write: if false;   // seed Admin uniquement
    }

    match /formations/{slug}/contenus/{leconId} {
      allow read: if aAchete()
                  && accesFormation(slug)
                  && (resource.data.offre != 'complet' || accesComplet(slug));
      allow write: if false;
    }

    // --- La progression -----------------------------------------------
    match /progression/{uid} {
      allow read, write: if aAchete() && request.auth.uid == uid;
    }

    // --- Les avis --------------------------------------------------------
    match /avis/{uid} {
      allow read: if resource.data.publie == true
                  || (connecte() && request.auth.uid == uid);
      allow create, update: if aAchete()
        && request.auth.uid == uid
        && request.resource.data.publie == false
        && request.resource.data.note is int
        && request.resource.data.note >= 1
        && request.resource.data.note <= 5
        && request.resource.data.texte is string
        && request.resource.data.texte.size() > 0
        && request.resource.data.texte.size() <= 1200
        && request.resource.data.prenom is string
        && request.resource.data.prenom.size() > 0
        && request.resource.data.prenom.size() <= 60;
    }

    // --- Le support : un message à la fois -------------------------------
    match /conversations/{uid} {
      allow read: if aAchete() && request.auth.uid == uid;

      allow create: if aAchete()
        && request.auth.uid == uid
        && request.resource.data.tour == 'nadir'
        && request.resource.data.messages.size() == 1
        && request.resource.data.dernier.de == 'membre'
        && request.resource.data.dernier.texte is string
        && request.resource.data.dernier.texte.size() > 0
        && request.resource.data.dernier.texte.size() <= 2000;

      allow update: if aAchete()
        && request.auth.uid == uid
        && resource.data.tour == 'membre'
        && request.resource.data.tour == 'nadir'
        && request.resource.data.messages.size() == resource.data.messages.size() + 1
        && request.resource.data.dernier.de == 'membre'
        && request.resource.data.dernier.texte is string
        && request.resource.data.dernier.texte.size() > 0
        && request.resource.data.dernier.texte.size() <= 2000;
    }

    // --- La liste d'attente du lancement ---------------------------------
    // Création anonyme (un e-mail = un document), jamais de lecture :
    // les adresses ne sont visibles que par l'admin (SDK Admin).
    match /attente/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'date', 'source', 'langue'])
        && request.resource.data.email is string
        && request.resource.data.email == email
        && email.matches('.+@.+[.].+')
        && email.size() <= 120
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 40;
      allow read, update, delete: if false;
    }

    // --- Tout le reste est fermé ---------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
